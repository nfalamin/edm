<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:System="clr-namespace:System;assembly=mscorlib">

    <!-- =====================================================================
         PREMIUM LIGHT THEME — EDM (Exclusive Download Manager)
         Crisp, crystal-clear typography, high-contrast readable buttons & cards
         ===================================================================== -->

    <!-- ===== BACKGROUND LAYERS ===== -->
    <SolidColorBrush x:Key="BackgroundBrush"          Color="#F8FAFC"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush"     Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush"     Color="#FFFFFF"/>

    <!-- Cards, Panels -->
    <SolidColorBrush x:Key="CardBrush"            Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush"         Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentColorBrush"     Color="#7C3AED"/>

    <!-- ===== BORDERS ===== -->
    <SolidColorBrush x:Key="BorderBrush"      Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderBrushColor" Color="#E2E8F0"/>

    <!-- ===== TEXT — Crystal clear, maximum contrast ===== -->
    <SolidColorBrush x:Key="PrimaryTextBrush"   Color="#0F172A"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#475569"/>
    <SolidColorBrush x:Key="DisabledBrush"      Color="#94A3B8"/>
    <SolidColorBrush x:Key="MutedTextBrush"     Color="#64748B"/>
    <SolidColorBrush x:Key="PrimaryText"        Color="#0F172A"/>
    <SolidColorBrush x:Key="SecondaryText"      Color="#475569"/>
    <SolidColorBrush x:Key="TextBrush"          Color="#0F172A"/>

    <!-- ===== ACCENT COLORS ===== -->
    <SolidColorBrush x:Key="AccentBrush"          Color="#7C3AED"/>
    <SolidColorBrush x:Key="AccentHoverBrush"     Color="#6D28D9"/>
    <SolidColorBrush x:Key="PrimaryBrush"         Color="#7C3AED"/>
    <SolidColorBrush x:Key="PrimaryAccent"        Color="#7C3AED"/>
    <SolidColorBrush x:Key="PurpleLightBrush"     Color="#7C3AED"/>
    <SolidColorBrush x:Key="PurpleBrush"          Color="#7C3AED"/>
    <SolidColorBrush x:Key="BorderHighlightBrush" Color="#7C3AED"/>

    <!-- Semantic colors -->
    <SolidColorBrush x:Key="SuccessBrush"   Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush"   Color="#F59E0B"/>
    <SolidColorBrush x:Key="ErrorBrush"     Color="#EF4444"/>
    <SolidColorBrush x:Key="GreenBrush"     Color="#10B981"/>
    <SolidColorBrush x:Key="OrangeBrush"    Color="#F59E0B"/>
    <SolidColorBrush x:Key="BlueLightBrush" Color="#3B82F6"/>

    <!-- Category badge brushes -->
    <SolidColorBrush x:Key="CategoryBackgroundBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="CategoryTextBrush"       Color="#FFFFFF"/>

    <!-- ===== ACTION BUTTON GRADIENTS ===== -->
    <LinearGradientBrush x:Key="PrimaryPillGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4F46E5" Offset="0.0"/>
        <GradientStop Color="#7C3AED" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AddUrlGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0.0"/>
        <GradientStop Color="#8B5CF6" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ResumeGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0.0"/>
        <GradientStop Color="#22C55E" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PauseGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F59E0B" Offset="0.0"/>
        <GradientStop Color="#F97316" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StopGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EF4444" Offset="0.0"/>
        <GradientStop Color="#DC2626" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DeleteGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EC4899" Offset="0.0"/>
        <GradientStop Color="#D946EF" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SchedulerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#06B6D4" Offset="0.0"/>
        <GradientStop Color="#3B82F6" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SettingsGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0.0"/>
        <GradientStop Color="#6366F1" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ShimmerBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C3AED" Offset="0.0"/>
        <GradientStop Color="#A855F7" Offset="0.5"/>
        <GradientStop Color="#7C3AED" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0.0"/>
        <GradientStop Color="#8B5CF6" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GreenGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0.0"/>
        <GradientStop Color="#22C55E" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AmberGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F59E0B" Offset="0.0"/>
        <GradientStop Color="#F97316" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BlueGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0EA5E9" Offset="0.0"/>
        <GradientStop Color="#3B82F6" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RedGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EF4444" Offset="0.0"/>
        <GradientStop Color="#DC2626" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MagentaGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EC4899" Offset="0.0"/>
        <GradientStop Color="#D946EF" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4F46E5" Offset="0.0"/>
        <GradientStop Color="#7C3AED" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ===== SHADOW EFFECTS ===== -->
    <DropShadowEffect x:Key="PurpleGlowShadow" BlurRadius="14" ShadowDepth="2" Color="#8B5CF6" Opacity="0.5"/>
    <DropShadowEffect x:Key="GreenGlowShadow"  BlurRadius="14" ShadowDepth="2" Color="#10B981" Opacity="0.5"/>
    <DropShadowEffect x:Key="AmberGlowShadow"  BlurRadius="14" ShadowDepth="2" Color="#F59E0B" Opacity="0.5"/>
    <DropShadowEffect x:Key="RedGlowShadow"    BlurRadius="14" ShadowDepth="2" Color="#EF4444" Opacity="0.5"/>
    <DropShadowEffect x:Key="PinkGlowShadow"   BlurRadius="14" ShadowDepth="2" Color="#EC4899" Opacity="0.5"/>
    <DropShadowEffect x:Key="CyanGlowShadow"   BlurRadius="14" ShadowDepth="2" Color="#06B6D4" Opacity="0.5"/>
    <DropShadowEffect x:Key="BlueGlowShadow"   BlurRadius="14" ShadowDepth="2" Color="#3B82F6" Opacity="0.5"/>
    <DropShadowEffect x:Key="CardShadow"       BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="#0F172A"/>
    <DropShadowEffect x:Key="ControlShadow"    BlurRadius="8"  ShadowDepth="1" Opacity="0.08" Color="#0F172A"/>

    <!-- ===== SIDEBAR / NAV ===== -->
    <SolidColorBrush x:Key="SidebarBg"          Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SidebarTextBrush"    Color="#334155"/>
    <SolidColorBrush x:Key="NavHoverBg"          Color="#E2E8F0"/>
    <SolidColorBrush x:Key="NavActiveBg"         Color="#4F46E5"/>
    <SolidColorBrush x:Key="NavActiveTextBrush"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryTextBrushNav" Color="#0F172A"/>

    <!-- ===== MISC UI ===== -->
    <SolidColorBrush x:Key="TopBarBg"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TableRowBg"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TableRowHoverBg"  Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SearchBoxBg"      Color="#F8FAFC"/>
    <SolidColorBrush x:Key="CardInputBg"      Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SelectionBrush"   Color="#E2E8F0"/>
    <SolidColorBrush x:Key="DeepBackgroundBrush" Color="#E2E8F0"/>

</ResourceDictionary>
