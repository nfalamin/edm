<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:System="clr-namespace:System;assembly=mscorlib">

    <!-- ==================== DEEP MIDNIGHT INDIGO & VIBRANT GLOW ==================== -->
    <Color x:Key="DeepVoidBlue">#070D1E</Color>
    <Color x:Key="GlassmorphicCard">#0D162E</Color>
    <Color x:Key="CardBorder">#182647</Color>
    <Color x:Key="SurfaceLight">#0F1A36</Color>

    <!-- ==================== PRIMARY GRADIENTS ==================== -->
    <!-- Indigo & Purple Highlights -->
    <Color x:Key="PrimaryPurpleLight">#6366F1</Color>
    <Color x:Key="PrimaryPurpleDark">#8B5CF6</Color>

    <!-- Active Green -->
    <Color x:Key="SuccessGreen">#10B981</Color>
    <Color x:Key="SuccessGreenDark">#22C55E</Color>

    <!-- Action Amber -->
    <Color x:Key="WarningAmber">#F59E0B</Color>
    <Color x:Key="WarningAmberDark">#F97316</Color>

    <!-- Cobalt Electric Blue -->
    <Color x:Key="AccentBlue">#7C3AED</Color>
    <Color x:Key="AccentBlueDark">#4F46E5</Color>

    <!-- Glowing Magenta/Pink -->
    <Color x:Key="MagentaPink">#EC4899</Color>
    <Color x:Key="MagentaPinkDark">#D946EF</Color>

    <!-- Destructive Red -->
    <Color x:Key="DestructiveRed">#EF4444</Color>
    <Color x:Key="DestructiveRedDark">#DC2626</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimary">#F0F4F8</Color>
    <Color x:Key="TextSecondary">#8B9EB7</Color>
    <Color x:Key="TextMuted">#64748B</Color>
    <Color x:Key="TextSuccess">#10B981</Color>
    <Color x:Key="TextWarning">#F59E0B</Color>

    <!-- Text brushes -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource TextMuted}"/>

    <!-- UI brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource DeepVoidBlue}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceLight}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource GlassmorphicCard}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource CardBorder}"/>
    <SolidColorBrush x:Key="CardInputBg" Color="#0B132B"/>
    <SolidColorBrush x:Key="NavHoverBg" Color="#162345"/>

    <!-- Accent and semantic brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#41C9E2"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="{StaticResource GlassmorphicCard}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessGreen}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningAmber}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource DestructiveRed}"/>

    <!-- Header and Secondary Background Brushes for Title Bar and Secondary Content -->
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#0D162E"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#080F22"/>

    <!-- Purple Light Brush for subtle accents (e.g., version badge text) -->
    <SolidColorBrush x:Key="PurpleLightBrush" Color="#41C9E2"/>

    <!-- Keep legacy aliases for compatibility -->
    <SolidColorBrush x:Key="PrimaryText" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="SecondaryText" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="PrimaryAccent" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource SuccessGreen}"/>
    <SolidColorBrush x:Key="BlueLightBrush" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource WarningAmber}"/>
    <SolidColorBrush x:Key="BorderBrushColor" Color="{StaticResource CardBorder}"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource DeepVoidBlue}"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#008DDA" Offset="0.0"/>
        <GradientStop Color="#41C9E2" Offset="1.0"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="#000000"/>

    <!-- ==================== LINEAR GRADIENTS & SHIMMER ==================== -->
    <LinearGradientBrush x:Key="ShimmerBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#008DDA" Offset="0.0"/>
        <GradientStop Color="#41C9E2" Offset="0.5"/>
        <GradientStop Color="#008DDA" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryPurpleLight}" Offset="0.0"/>
        <GradientStop Color="{StaticResource PrimaryPurpleDark}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GreenGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource SuccessGreen}" Offset="0.0"/>
        <GradientStop Color="{StaticResource SuccessGreenDark}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AmberGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource WarningAmber}" Offset="0.0"/>
        <GradientStop Color="{StaticResource WarningAmberDark}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BlueGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentBlue}" Offset="0.0"/>
        <GradientStop Color="{StaticResource AccentBlueDark}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MagentaGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource MagentaPink}" Offset="0.0"/>
        <GradientStop Color="{StaticResource MagentaPinkDark}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RedGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource DestructiveRed}" Offset="0.0"/>
        <GradientStop Color="{StaticResource DestructiveRedDark}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DeleteGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource DestructiveRed}" Offset="0.0"/>
        <GradientStop Color="{StaticResource DestructiveRedDark}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HorizontalPurpleGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#008DDA" Offset="0.0"/>
        <GradientStop Color="#41C9E2" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ==================== RADIAL GRADIENTS ==================== -->
    <RadialGradientBrush x:Key="PurpleRadialGlow">
        <GradientStop Color="{StaticResource PrimaryPurpleLight}" Offset="0.0"/>
        <GradientStop Color="{StaticResource PrimaryPurpleDark}" Offset="1.0"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="GreenRadialGlow">
        <GradientStop Color="{StaticResource SuccessGreen}" Offset="0.0"/>
        <GradientStop Color="{StaticResource SuccessGreenDark}" Offset="1.0"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="BlueRadialGlow">
        <GradientStop Color="{StaticResource AccentBlue}" Offset="0.0"/>
        <GradientStop Color="{StaticResource AccentBlueDark}" Offset="1.0"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="VioletRadialGlow">
        <GradientStop Color="{StaticResource MagentaPink}" Offset="0.0"/>
        <GradientStop Color="{StaticResource MagentaPinkDark}" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- ==================== SHADOW EFFECTS ==================== -->
    <DropShadowEffect x:Key="GlassGlow" BlurRadius="15" ShadowDepth="2" Opacity="0.6" Color="{StaticResource PrimaryPurpleLight}"/>
    <DropShadowEffect x:Key="GlassGlowGreen" BlurRadius="15" ShadowDepth="2" Opacity="0.6" Color="{StaticResource SuccessGreen}"/>
    <DropShadowEffect x:Key="GlassGlowBlue" BlurRadius="15" ShadowDepth="2" Opacity="0.6" Color="{StaticResource AccentBlue}"/>
    <DropShadowEffect x:Key="GlassGlowAmber" BlurRadius="15" ShadowDepth="2" Opacity="0.6" Color="{StaticResource WarningAmber}"/>

    <!-- ==================== MARGIN & PADDING CONSTANTS ==================== -->
    <Thickness x:Key="SmallPadding">8</Thickness>
    <Thickness x:Key="MediumPadding">12</Thickness>
    <Thickness x:Key="LargePadding">16</Thickness>
    <Thickness x:Key="ExtraLargePadding">20</Thickness>

    <!-- ==================== FONT SIZES ==================== -->
    <System:Double x:Key="FontSizeCaption">11</System:Double>
    <System:Double x:Key="FontSizeSmall">12</System:Double>
    <System:Double x:Key="FontSizeNormal">13</System:Double>
    <System:Double x:Key="FontSizeLarge">14</System:Double>
    <System:Double x:Key="FontSizeXLarge">16</System:Double>
    <System:Double x:Key="FontSizeTitle">18</System:Double>
    <System:Double x:Key="FontSizeHeading">20</System:Double>
    <System:Double x:Key="FontSizeDisplay">32</System:Double>

</ResourceDictionary>
