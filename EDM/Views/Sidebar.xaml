<UserControl x:Class="EDM.Views.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="250"
             Background="{DynamicResource SidebarBg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>     <!-- Nav items -->
            <RowDefinition Height="Auto"/>  <!-- Real-time speed graph -->
            <RowDefinition Height="Auto"/>  <!-- Copyright -->
        </Grid.RowDefinitions>

        <!-- ==================== NAVIGATION ITEMS ==================== -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="8,8,8,0">

                <!-- Dashboard (Active) -->
                <Button x:Name="DashboardBtn" Click="NavCategory_Click" Tag="Dashboard"
                        Cursor="Hand" Margin="0,2" BorderThickness="0" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" CornerRadius="8" Padding="12,10" Background="{DynamicResource PrimaryPillGradient}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#7C3AED" BlurRadius="14" ShadowDepth="2" Opacity="0.55"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IconText" Grid.Column="0" Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBlock x:Name="LabelText" Grid.Column="1" Text="Dashboard" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.92"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Separator -->
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,8"/>

                <!-- All Downloads -->
                <Button x:Name="AllDownloadsBtn" Click="NavCategory_Click" Tag="AllDownloads"
                        Cursor="Hand" Margin="0,1" BorderThickness="0" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="8" Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IconText" Grid.Column="0" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource SidebarTextBrush}"/>
                                    <TextBlock x:Name="LabelText" Grid.Column="1" Text="All Downloads" FontSize="12" Foreground="{DynamicResource SidebarTextBrush}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#7C3AED" CornerRadius="11" Padding="8,4" Margin="8,0,0,0" MinWidth="22" Height="22" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ViewModel.TotalDownloadsCount, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Downloading -->
                <Button x:Name="DownloadingBtn" Click="NavCategory_Click" Tag="Downloading"
                        Cursor="Hand" Margin="0,1" BorderThickness="0" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="8" Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IconText" Grid.Column="0" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource SidebarTextBrush}"/>
                                    <TextBlock x:Name="LabelText" Grid.Column="1" Text="Downloading" FontSize="12" Foreground="{DynamicResource SidebarTextBrush}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#10B981" CornerRadius="11" Padding="8,4" Margin="8,0,0,0" MinWidth="22" Height="22" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ViewModel.ActiveDownloadsCount, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Completed -->
                <Button x:Name="CompletedBtn" Click="NavCategory_Click" Tag="Completed"
                        Cursor="Hand" Margin="0,1" BorderThickness="0" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="8" Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IconText" Grid.Column="0" Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource SidebarTextBrush}"/>
                                    <TextBlock x:Name="LabelText" Grid.Column="1" Text="Completed" FontSize="12" Foreground="{DynamicResource SidebarTextBrush}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#2563EB" CornerRadius="11" Padding="8,4" Margin="8,0,0,0" MinWidth="22" Height="22" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ViewModel.CompletedDownloadsCount, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Compressed -->
                <Button Click="NavCategory_Click" Tag="Compressed" Cursor="Hand" Margin="0,1" BorderThickness="0" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="8" Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IconText" Grid.Column="0" Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource SidebarTextBrush}"/>
                                    <TextBlock x:Name="LabelText" Grid.Column="1" Text="Compressed" FontSize="12" Foreground="{DynamicResource SidebarTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Video -->
                <Button Click="NavCategory_Click" Tag="Video" Cursor="Hand" Margin="0,1" BorderThickness="0" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="8" Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IconText" Grid.Column="0" Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource SidebarTextBrush}"/>
                                    <TextBlock x:Name="LabelText" Grid.Column="1" Text="Video" FontSize="12" Foreground="{DynamicResource SidebarTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Music -->
                <Button Click="NavCategory_Click" Tag="Music" Cursor="Hand" Margin="0,1" BorderThickness="0" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="8" Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IconText" Grid.Column="0" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource SidebarTextBrush}"/>
                                    <TextBlock x:Name="LabelText" Grid.Column="1" Text="Music" FontSize="12" Foreground="{DynamicResource SidebarTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Documents -->
                <Button Click="NavCategory_Click" Tag="Documents" Cursor="Hand" Margin="0,1" BorderThickness="0" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="8" Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IconText" Grid.Column="0" Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource SidebarTextBrush}"/>
                                    <TextBlock x:Name="LabelText" Grid.Column="1" Text="Documents" FontSize="12" Foreground="{DynamicResource SidebarTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Programs -->
                <Button Click="NavCategory_Click" Tag="Programs" Cursor="Hand" Margin="0,1" BorderThickness="0" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="8" Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IconText" Grid.Column="0" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource SidebarTextBrush}"/>
                                    <TextBlock x:Name="LabelText" Grid.Column="1" Text="Programs" FontSize="12" Foreground="{DynamicResource SidebarTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Queues -->
                <Button Click="NavCategory_Click" Tag="Queues" Cursor="Hand" Margin="0,1" BorderThickness="0" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="8" Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IconText" Grid.Column="0" Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource SidebarTextBrush}"/>
                                    <TextBlock x:Name="LabelText" Grid.Column="1" Text="Queues" FontSize="12" Foreground="{DynamicResource SidebarTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Separator -->
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,10"/>

                <!-- Scheduler -->
                <Button Click="NavCategory_Click" Tag="Scheduler" Cursor="Hand" Margin="0,1" BorderThickness="0" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="8" Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IconText" Grid.Column="0" Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#38BDF8"/>
                                    <TextBlock x:Name="LabelText" Grid.Column="1" Text="Scheduler" FontSize="12" Foreground="{DynamicResource SidebarTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                    <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Settings -->
                <Button Click="NavCategory_Click" Tag="Settings" Cursor="Hand" Margin="0,1" BorderThickness="0" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="8" Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IconText" Grid.Column="0" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#A78BFA"/>
                                    <TextBlock x:Name="LabelText" Grid.Column="1" Text="Settings" FontSize="12" Foreground="{DynamicResource SidebarTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                    <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </ScrollViewer>

        <!-- ==================== REAL-TIME SPEED GRAPH CARD ==================== -->
        <!-- Replaces the Upgrade to Premium card -->
        <Border Grid.Row="1" Background="{DynamicResource NavHoverBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Margin="10,6,10,4" Padding="12,12">
            <StackPanel>

                <!-- Graph Card Header -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Download Speed" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="SpeedPeakLabel" Text="↑ Peak: 0.0 MB/s" FontSize="9"
                                   Foreground="{DynamicResource SidebarTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Live speed value badge -->
                    <Border Grid.Column="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="#3B82F6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="SpeedValueLabel" Text="0.0 MB/s"
                                   FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </Grid>

                <!-- Canvas for the animated polyline graph -->
                <Border Background="{DynamicResource SidebarBg}" CornerRadius="8" Height="76" ClipToBounds="True">
                    <Canvas x:Name="SpeedGraphCanvas" Background="Transparent">
                        <!-- Grid guide lines (subtle horizontal lines) -->
                        <Line X1="0" Y1="26" X2="230" Y2="26" Stroke="{DynamicResource BorderBrush}" StrokeThickness="0.5"/>
                        <Line X1="0" Y1="52" X2="230" Y2="52" Stroke="{DynamicResource BorderBrush}" StrokeThickness="0.5"/>

                        <!-- Fill polygon (gradient area under the line) -->
                        <Polygon x:Name="SpeedGraphFill" StrokeThickness="0" Opacity="0.3">
                            <Polygon.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#3B82F600" Offset="1"/>
                                </LinearGradientBrush>
                            </Polygon.Fill>
                        </Polygon>

                        <!-- Main speed graph line -->
                        <Polyline x:Name="SpeedGraphLine"
                                  Stroke="#7C3AED"
                                  StrokeThickness="2"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                    </Canvas>
                </Border>

                <!-- Speed labels row -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Live" FontSize="9" Foreground="#10B981"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1.0" To="0.3"
                                                                 Duration="0:0:0.9"
                                                                 AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Green dot pulse indicator -->
                    <Ellipse Grid.Column="1" Width="7" Height="7" Fill="#10B981"
                             VerticalAlignment="Center" Margin="4,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1.0" To="0.2"
                                                                 Duration="0:0:0.9"
                                                                 AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Grid.Column="2" Text="Active" FontSize="9" Foreground="{DynamicResource SidebarTextBrush}" VerticalAlignment="Center"/>
                </Grid>

            </StackPanel>
        </Border>

        <!-- ==================== COPYRIGHT ==================== -->
        <TextBlock Grid.Row="2" Text="© 2026 Exclusive Download Manager (EDM). All rights reserved."
                   FontSize="9.5" Foreground="{DynamicResource SidebarTextBrush}"
                   HorizontalAlignment="Center" Margin="0,4,0,10"/>

    </Grid>

</UserControl>
