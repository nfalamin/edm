<Window x:Class="EDM.Views.RefreshExpiredUrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Refresh Expired Download Address — EDM"
        Height="380" Width="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0"
                Background="#33FF9800"
                BorderBrush="#FF9800"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="⚠️ Download Address Expired"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#FFA726" />
                <TextBlock Text="The server rejected the download session (HTTP 401/403/410 or Token Expired). Please open the download page in your browser or paste the new download link below to resume from existing progress."
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Details Grid -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="File Name: " FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,8,2" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FileNameText" Text="archive_sample.zip (540 MB / 1.2 GB)" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,2" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Existing Progress: " FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,8,2" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProgressText" Text="45.0% downloaded (Segments 1-14 preserved in WAL)" Foreground="#4CAF50" FontWeight="SemiBold" Margin="0,2,0,2" />
        </Grid>

        <!-- New URL Input -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="New Download Address (URL):"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,6" />
            <TextBox x:Name="NewUrlBox"
                     Padding="8"
                     FontSize="12"
                     Background="{DynamicResource SecondaryBackgroundBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     VerticalAlignment="Center" />
            <TextBlock x:Name="StatusMessageText"
                       Text=""
                       FontSize="11"
                       Foreground="#E53935"
                       Margin="0,6,0,0" />
        </StackPanel>

        <!-- Options -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,12">
            <Button Content="🌐 Open Download Page in Browser"
                    Click="OnOpenInBrowser"
                    Padding="10,6"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    Foreground="{DynamicResource PrimaryTextBrush}" />
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="OnCancel" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="Validate &amp; Resume"
                    Click="OnValidateAndResume"
                    Padding="16,6"
                    Background="{DynamicResource AccentColorBrush}"
                    Foreground="White"
                    FontWeight="Bold" />
        </StackPanel>
    </Grid>
</Window>
