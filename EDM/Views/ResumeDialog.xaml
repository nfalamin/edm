<Window x:Class="EDM.Views.ResumeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resume Downloads" Height="360" Width="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Resumable downloads detected:" FontWeight="Bold" />

        <ListView x:Name="ResumableList" Grid.Row="1" Margin="0,8,0,8" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="File" Width="220" DisplayMemberBinding="{Binding FileName}" />
                    <GridViewColumn Header="Path" Width="260" DisplayMemberBinding="{Binding SavePath}" />
                    <GridViewColumn Header="Status" Width="80" DisplayMemberBinding="{Binding Status}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="ResumeButton" Content="Resume" Width="90" />
            <Button x:Name="DeleteButton" Content="Delete/Clean Up" Width="120" />
            <Button x:Name="CloseButton" Content="Close" Width="80" />
        </StackPanel>
    </Grid>
</Window>