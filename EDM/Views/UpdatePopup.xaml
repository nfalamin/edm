<Window x:Class="EDM.Views.UpdatePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exclusive Download Manager Update" 
        Height="520" Width="720" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent">

    <Border CornerRadius="12" Background="{DynamicResource WindowBackgroundBrush}" Padding="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <!-- Update Type Pill Badge -->
                        <Border x:Name="TierBadge" CornerRadius="6" Padding="8,3" Background="#7C3AED" Margin="0,0,10,0">
                            <TextBlock x:Name="TierBadgeText" Text="✨ NEW UPDATE" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock x:Name="VersionHeadingText" Text="EDM v1.1.0 is Available" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="SubtitleText" Text="A new version of Exclusive Download Manager is available for download." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Close Button (Hidden on Mandatory updates) -->
                <Button x:Name="CloseBtn" Grid.Column="1" Width="30" Height="30" Click="CloseBtn_Click" 
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryTextBrush}" 
                        FontSize="14" Cursor="Hand" VerticalAlignment="Top">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Mandatory Warning Box (Visible only on Mandatory updates) -->
            <Border x:Name="MandatoryWarningBox" Grid.Row="0" Margin="0,54,0,0" Visibility="Collapsed"
                    Background="#2D1515" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="18" Foreground="#EF4444" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="This version is deprecated. You must update now to continue using EDM." 
                               FontSize="12" FontWeight="SemiBold" Foreground="#FCA5A5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Changelog & Release Notes Area -->
            <Border Grid.Row="1" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,10,0,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Release Highlights &amp; Changes:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="ChangelogText" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Download Progress Panel -->
            <StackPanel Grid.Row="2" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,14">
                <TextBlock x:Name="ProgressStatusText" Text="Downloading update package..." Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,0,0,6"/>
                <ProgressBar x:Name="UpdateProgressBar" Height="10" Minimum="0" Maximum="100" Value="0" Foreground="#7C3AED">
                    <ProgressBar.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </ProgressBar.Resources>
                </ProgressBar>
            </StackPanel>

            <!-- Action Button Footer -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left-aligned: Skip Version Button (Optional Updates Only) -->
                <Button x:Name="SkipVersionBtn" Grid.Column="0" Content="Skip This Version" 
                        Click="SkipVersionBtn_Click"
                        Background="Transparent" Foreground="{DynamicResource MutedTextBrush}" 
                        BorderThickness="0" Padding="8,6" FontSize="11" Cursor="Hand"/>

                <!-- Right-aligned Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Remind Me Later / Cancel (Optional Updates Only) -->
                    <Button x:Name="RemindLaterBtn" Content="Remind Me Later" 
                            Click="RemindLaterBtn_Click"
                            Background="{DynamicResource NavHoverBg}" 
                            Foreground="{DynamicResource PrimaryTextBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" Padding="16,9" FontSize="12" FontWeight="SemiBold" 
                            Cursor="Hand" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Exit App Button (Mandatory Updates Only) -->
                    <Button x:Name="ExitAppBtn" Content="Exit EDM" 
                            Click="ExitAppBtn_Click" Visibility="Collapsed"
                            Background="#334155" Foreground="White" 
                            BorderThickness="0" Padding="18,9" FontSize="12" FontWeight="SemiBold" 
                            Cursor="Hand" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Primary Update Now Button -->
                    <Button x:Name="DownloadBtn" Content="Update Now" 
                            Click="DownloadBtn_Click"
                            Background="#7C3AED" Foreground="White" 
                            BorderThickness="0" Padding="22,9" FontSize="12" FontWeight="Bold" 
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
