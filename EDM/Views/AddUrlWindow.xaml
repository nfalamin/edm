<Window x:Class="EDM.Views.AddUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Download"
        Height="570" Width="680"
        MinHeight="540" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0B1120"
        Foreground="#F8FAFC">

    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding StartDownloadKeyCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelKeyCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"/>
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <!-- High-Contrast Explicit Dark Theme Brushes -->
            <SolidColorBrush x:Key="DlgBg" Color="#0B1120"/>
            <SolidColorBrush x:Key="DlgCardBg" Color="#131D31"/>
            <SolidColorBrush x:Key="DlgHeaderBg" Color="#0D1527"/>
            <SolidColorBrush x:Key="DlgInputBg" Color="#080E1A"/>
            <SolidColorBrush x:Key="DlgBorder" Color="#223354"/>
            <SolidColorBrush x:Key="DlgBorderHover" Color="#6366F1"/>
            <SolidColorBrush x:Key="DlgTextPrimary" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DlgTextSecondary" Color="#94A3B8"/>
            <SolidColorBrush x:Key="DlgTextMuted" Color="#64748B"/>
            <SolidColorBrush x:Key="DlgAccent" Color="#6366F1"/>
            <SolidColorBrush x:Key="DlgAccentGlow" Color="#8B5CF6"/>
            <SolidColorBrush x:Key="DlgSuccess" Color="#10B981"/>

            <!-- High-Contrast TextBox Style -->
            <Style x:Key="CrystalDarkTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource DlgInputBg}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="CaretBrush" Value="#6366F1"/>
                <Setter Property="BorderBrush" Value="{StaticResource DlgBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="TBBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="10">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TBBorder" Property="BorderBrush" Value="#4F46E5"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="TBBorder" Property="BorderBrush" Value="#6366F1"/>
                                    <Setter TargetName="TBBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#6366F1" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- High-Contrast ComboBox Style -->
            <Style x:Key="CrystalDarkComboBox" TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource DlgInputBg}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="{StaticResource DlgBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,9"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" 
                                              Focusable="False" 
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleBorder" 
                                                    Background="{StaticResource DlgInputBg}" 
                                                    BorderBrush="{StaticResource DlgBorder}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="34"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path x:Name="Arrow" 
                                                          Grid.Column="1" 
                                                          HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center" 
                                                          Data="M 0 0 L 4 4 L 8 0 Z" 
                                                          Fill="#94A3B8"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#6366F1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter x:Name="ContentSite" 
                                                  IsHitTestVisible="False" 
                                                  Content="{TemplateBinding SelectionBoxItem}" 
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                                  Margin="14,0,36,0" 
                                                  VerticalAlignment="Center" 
                                                  HorizontalAlignment="Left">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>

                                <Popup x:Name="Popup" 
                                       Placement="Bottom" 
                                       IsOpen="{TemplateBinding IsDropDownOpen}" 
                                       AllowsTransparency="True" 
                                       Focusable="False" 
                                       PopupAnimation="Slide">
                                    <Grid x:Name="DropDown" 
                                          MinWidth="{TemplateBinding ActualWidth}" 
                                          MaxHeight="260">
                                        <Border x:Name="DropDownBorder" 
                                                Background="#0D1527" 
                                                BorderBrush="{StaticResource DlgBorder}" 
                                                BorderThickness="1" 
                                                CornerRadius="10" 
                                                Margin="0,4,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="6" Opacity="0.7"/>
                                            </Border.Effect>
                                            <ScrollViewer Margin="6,6" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ComboBoxItem Style -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,1">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1E293B"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#6366F1"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary Gradient Button -->
            <Style x:Key="GlowPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#6366F1" Offset="0.0"/>
                            <GradientStop Color="#8B5CF6" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Padding" Value="24,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBrd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#6366F1" BlurRadius="16" ShadowDepth="2" Opacity="0.5"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBrd" Property="Opacity" Value="0.95"/>
                                    <Setter TargetName="BtnBrd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#8B5CF6" BlurRadius="22" ShadowDepth="3" Opacity="0.75"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBrd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="BtnBrd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Secondary Action Button -->
            <Style x:Key="CrystalSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#F8FAFC"/>
                <Setter Property="Background" Value="#1A263D"/>
                <Setter Property="BorderBrush" Value="{StaticResource DlgBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SecBrd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SecBrd" Property="Background" Value="#243352"/>
                                    <Setter TargetName="SecBrd" Property="BorderBrush" Value="#6366F1"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="SecBrd" Property="Opacity" Value="0.8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="SecBrd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Title Bar Header -->
        <Border Grid.Row="0" Background="{StaticResource DlgHeaderBg}" BorderBrush="{StaticResource DlgBorder}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#202A4A" CornerRadius="8" Padding="7,5" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="14" Foreground="#818CF8" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Add New Download" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Smart Multi-Thread Stream Analyzer" FontSize="11" Foreground="{StaticResource DlgTextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Form -->
        <Border Grid.Row="1" Padding="22,16" Background="{StaticResource DlgBg}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Top">

                    <!-- URL Input with Paste & Auto-Analyze -->
                    <TextBlock Text="DOWNLOAD URL" FontSize="11" Foreground="{StaticResource DlgTextSecondary}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- URL Input with placeholder -->
                        <Grid Grid.Column="0">
                            <TextBox x:Name="UrlTextBox" 
                                     Style="{StaticResource CrystalDarkTextBox}"
                                     Height="42"
                                     Text=""
                                     TextChanged="UrlTextBox_TextChanged"
                                     GotFocus="UrlTextBox_GotFocus"
                                     LostFocus="UrlTextBox_LostFocus"/>
                            <TextBlock x:Name="UrlPlaceholderText" 
                                       Text="Paste download link (http, https, ftp, youtube, magnet)..." 
                                       IsHitTestVisible="False" 
                                       Margin="16,0,0,0" 
                                       VerticalAlignment="Center" 
                                       Foreground="{StaticResource DlgTextMuted}" 
                                       FontSize="13"/>
                        </Grid>

                        <!-- Fast Paste Button -->
                        <Button x:Name="PasteButton" 
                                Grid.Column="1"
                                Content="📋 Paste" 
                                Click="PasteButton_Click"
                                Style="{StaticResource CrystalSecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                Width="80"/>

                        <!-- Analyze Button -->
                        <Button x:Name="AnalyzeButton" 
                                Grid.Column="2"
                                Content="🔍 Analyze" 
                                Click="AnalyzeButton_Click"
                                Style="{StaticResource CrystalSecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                Width="96"/>
                    </Grid>

                    <!-- Stream / Resource Inspection Card -->
                    <Border x:Name="AnalysisStatusCard" 
                            Background="{StaticResource DlgCardBg}" 
                            BorderBrush="{StaticResource DlgBorder}" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Padding="14,10" 
                            Margin="0,0,0,14" 
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="#1E293B" CornerRadius="8" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="AnalysisStatusIcon" Text="ℹ️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="AnalysisStatusTitle" Text="Media Detected" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="AnalysisStatusText" Text="Stream analysis in progress..." FontSize="12" Foreground="{StaticResource DlgTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Format & Quality Grid (Dynamic Media vs Direct Stream) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Format -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FORMAT / CONTAINER" FontSize="11" Foreground="{StaticResource DlgTextSecondary}" FontWeight="Bold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="FormatComboBox" 
                                      Style="{StaticResource CrystalDarkComboBox}"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Auto Detect"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Quality Selection -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="STREAM QUALITY" FontSize="11" Foreground="{StaticResource DlgTextSecondary}" FontWeight="Bold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="QualityComboBox" 
                                      Style="{StaticResource CrystalDarkComboBox}"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Best Available (Default)"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Save Path -->
                    <TextBlock Text="SAVE DIRECTORY" FontSize="11" Foreground="{StaticResource DlgTextSecondary}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <TextBox x:Name="SavePathTextBox" 
                                 Style="{StaticResource CrystalDarkTextBox}"
                                 Height="42"
                                 Text=""/>
                        <Button x:Name="BrowseButton" 
                                Grid.Column="1"
                                Content="📁 Browse..." 
                                Click="BrowseButton_Click"
                                Style="{StaticResource CrystalSecondaryButtonStyle}"
                                Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Category Selection -->
                    <TextBlock Text="CATEGORY" FontSize="11" Foreground="{StaticResource DlgTextSecondary}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CategoryComboBox" 
                              Style="{StaticResource CrystalDarkComboBox}"
                              Margin="0,0,0,12"
                              SelectedIndex="0"
                              SelectionChanged="CategoryComboBox_SelectionChanged">
                        <ComboBoxItem Content="General"/>
                        <ComboBoxItem Content="Video"/>
                        <ComboBoxItem Content="Audio"/>
                        <ComboBoxItem Content="Documents"/>
                        <ComboBoxItem Content="Programs"/>
                        <ComboBoxItem Content="Compressed"/>
                        <ComboBoxItem Content="Others"/>
                    </ComboBox>

                    <!-- Advanced Options Card -->
                    <Border Background="{StaticResource DlgCardBg}" BorderBrush="{StaticResource DlgBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="AutoStartCheckBox" 
                                      Content="Start download automatically" 
                                      Foreground="#FFFFFF"
                                      IsChecked="True"
                                      Margin="0,0,24,0"
                                      FontSize="12"/>
                            <CheckBox x:Name="CreateSubfolderCheckBox" 
                                      Content="Auto-route into category subfolder" 
                                      Foreground="#FFFFFF"
                                      IsChecked="True"
                                      FontSize="12"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bottom Action Buttons -->
        <Border Grid.Row="2" Background="{StaticResource DlgHeaderBg}" BorderBrush="{StaticResource DlgBorder}" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <TextBlock x:Name="SubmissionStatusText" Text="" Foreground="#EF4444" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" 
                            Content="Cancel" 
                            Click="Cancel_Click" 
                            Style="{StaticResource CrystalSecondaryButtonStyle}"
                            Margin="0,0,10,0"/>
                    <Button x:Name="StartDownloadButton" 
                            Content="⚡ Start Download" 
                            Click="StartDownload_Click" 
                            Style="{StaticResource GlowPrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
