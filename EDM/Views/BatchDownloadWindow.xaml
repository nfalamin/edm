<Window x:Class="EDM.Views.BatchDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Download Wizard — EDM" Height="520" Width="680"
        WindowStartupLocation="CenterScreen" Background="#0F1523" Foreground="#E2E8F0">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚡ Batch Download Pattern Wizard" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Enter a URL pattern with wildcards (e.g. http://example.com/file_[01-20].zip or image_[a-e].png)" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PatternInputTextBox" Grid.Column="0" Height="36" FontSize="13" 
                     Text="http://example.com/downloads/archive_[01-10].zip" Padding="8,4"/>
            <Button x:Name="GenerateButton" Grid.Column="1" Margin="10,0,0,0" Height="36" Padding="16,0"
                    Content="Generate Links" Click="GenerateButton_Click" Background="#7C3AED" Foreground="#FFFFFF" FontWeight="SemiBold"/>
        </Grid>

        <Border Grid.Row="2" Background="#131B2E" BorderBrush="#222F48" BorderThickness="1" CornerRadius="8" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="StatusTextBlock" Text="Ready. Paste pattern and click Generate." FontSize="12" Foreground="#A855F7" Margin="0,0,0,8" FontWeight="SemiBold"/>
                <ListView x:Name="LinksListView" Background="Transparent" BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Url}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Foreground="#E2E8F0" Margin="4,2"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SavePathTextBox" Grid.Column="0" Height="34" FontSize="12" Padding="8,4"/>
            <Button x:Name="BrowseButton" Grid.Column="1" Margin="10,0,0,0" Content="Browse..." Click="BrowseButton_Click" Height="34"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="CancelButton_Click" Width="90" Height="34"/>
            <Button x:Name="EnqueueButton" Content="Add Selected to Queue" Click="EnqueueButton_Click" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" Width="170" Height="34" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
