<Window x:Class="EDM.Views.DeleteConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Delete"
        Width="420"
        Height="220"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12" CornerRadius="10,10,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Confirm Deletion" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Button Grid.Column="1" Click="CloseButton_Click" Content="✕" Width="26" Height="26" Background="Transparent" Foreground="{DynamicResource SecondaryTextBrush}" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Row="1" Padding="20" VerticalAlignment="Center" Background="{DynamicResource BackgroundBrush}">
                <StackPanel>
                    <!-- Warning Icon -->
                    <TextBlock Text="⚠" FontSize="34" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <!-- Message -->
                    <TextBlock x:Name="FileNameTextBlock"
                               Text="Delete selected file?"
                               FontSize="13"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"
                               FontWeight="Bold"/>

                    <TextBlock Text="Are you sure you want to delete this download from the list?"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="This action cannot be undone."
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12" CornerRadius="0,0,10,10">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button Grid.Column="1"
                            Click="CancelButton_Click"
                            Content="Cancel"
                            Background="{DynamicResource NavHoverBg}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Padding="18,8"
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            FontSize="12"
                            FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Column="2"
                            Click="DeleteButton_Click"
                            Content="Delete"
                            Background="#EF4444"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="20,8"
                            Cursor="Hand"
                            FontSize="12"
                            FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
