<Window x:Class="EDM.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="900" Width="550" WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Default Download Folder:" VerticalAlignment="Center" Width="160"/>
                <TextBox x:Name="DefaultPathTextBox" Width="260" IsReadOnly="True"/>
                <Button Content="Browse..." Margin="8,0,0,0" Click="Browse_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="FFmpeg Path:" VerticalAlignment="Center" Width="160"/>
                <TextBox x:Name="FfmpegPathTextBox" Width="260" IsReadOnly="True"/>
                <Button Content="Browse..." Margin="8,0,0,0" Click="BrowseFfmpeg_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="yt-dlp Path:" VerticalAlignment="Center" Width="160"/>
                <TextBox x:Name="YtDlpPathTextBox" Width="200" IsReadOnly="True"/>
                <Button Content="Browse..." Margin="8,0,0,0" Click="BrowseYtDlp_Click"/>
                <Button Content="Test" Margin="8,0,0,0" Click="TestYtDlp_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="aria2c Path:" VerticalAlignment="Center" Width="160"/>
                <TextBox x:Name="Aria2PathTextBox" Width="260"/>
                <Button Content="Test" Margin="8,0,0,0" Click="TestAria2_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Default format args:" VerticalAlignment="Center" Width="160"/>
                <TextBox x:Name="FormatArgsTextBox" Width="260"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox x:Name="AutoConvertCheckBox" Content="Auto-convert downloaded video to MP3 when requested" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox x:Name="SendCrashReportsCheckBox" Content="Send anonymous crash reports" ToolTip="When enabled, crash reports may be sent anonymously to a collection endpoint (currently disabled)." />
                <Button Content="Open Crash Reports Folder" Margin="12,0,0,0" Click="OpenCrashReportsFolder_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                <Button Content="🔑 Manage Site Logins &amp; Passwords (DPAPI Vault)..." Margin="0,0,8,0" Padding="8,4" Click="OpenSiteLoginsManager_Click"/>
                <Button Content="📁 Edit Category Routing Rules..." Padding="8,4" Click="OpenCategoryRulesEditor_Click"/>
            </StackPanel>
        </StackPanel>

        <GroupBox Header="URL Safety Checking (Optional)" Grid.Row="1" Margin="0,0,0,10" Padding="8">
            <StackPanel Orientation="Vertical">
                <CheckBox x:Name="EnableSafetyCheckBox" Content="Check URLs with Google Safe Browsing (requires API key)" 
                          Margin="0,0,0,8" Checked="SafetyEnabledCheckBox_Changed" Unchecked="SafetyEnabledCheckBox_Changed"/>

                <StackPanel x:Name="SafetyOptionsPanel" Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="False">
                    <TextBlock Text="Google Safe Browsing API Key:" VerticalAlignment="Center" Width="200"/>
                    <PasswordBox x:Name="ApiKeyPasswordBox" Width="220" />
                    <TextBlock x:Name="ApiKeyStatusText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Green" Text="✓ Configured"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Proxy (Network)" Grid.Row="2" Margin="0,0,0,10" Padding="8">
            <StackPanel Orientation="Vertical">
                <CheckBox x:Name="ProxyEnabledCheckBox" Content="Use a proxy server for all downloads" Margin="0,0,0,8"
                          Checked="ProxyEnabledCheckBox_Changed" Unchecked="ProxyEnabledCheckBox_Changed"/>

                <StackPanel x:Name="ProxyOptionsPanel" Orientation="Vertical" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Type:" VerticalAlignment="Center" Width="70"/>
                        <ComboBox x:Name="ProxyTypeComboBox" Width="120">
                            <ComboBoxItem Content="HTTP"/>
                            <ComboBoxItem Content="HTTPS"/>
                            <ComboBoxItem Content="SOCKS5"/>
                        </ComboBox>
                        <TextBlock Text="Host:" VerticalAlignment="Center" Width="45" Margin="12,0,0,0"/>
                        <TextBox x:Name="ProxyHostTextBox" Width="140"/>
                        <TextBlock Text="Port:" VerticalAlignment="Center" Width="35" Margin="8,0,0,0"/>
                        <TextBox x:Name="ProxyPortTextBox" Width="55"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Username:" VerticalAlignment="Center" Width="70"/>
                        <TextBox x:Name="ProxyUsernameTextBox" Width="150"/>
                        <TextBlock Text="Password:" VerticalAlignment="Center" Width="65" Margin="12,0,0,0"/>
                        <PasswordBox x:Name="ProxyPasswordBox" Width="140"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox x:Name="ProxyBypassLocalCheckBox" Content="Bypass proxy for local/LAN addresses" IsChecked="True"/>
                        <Button Content="Test Connection" Margin="16,0,0,0" Padding="6,2" Click="TestProxy_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ProxyTestResultText" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Windows Explorer Integration" Grid.Row="3" Margin="0,0,0,10" Padding="8">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Context Menu:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ContextMenuStatusText" 
                               VerticalAlignment="Center" 
                               Margin="0,0,12,0"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <Button x:Name="ToggleContextMenuButton"
                            Content="Enable"
                            Width="100"
                            Height="30"
                            Click="ToggleContextMenu_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Bandwidth Scheduling" Grid.Row="4" Margin="0,0,0,10" Padding="8">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Configure time-based speed limits:" Margin="0,0,0,8" FontWeight="Bold"/>

                <!-- Current schedules list -->
                <TextBlock Text="Active Schedules:" Margin="0,0,0,4"/>
                <ListBox x:Name="BandwidthSchedulesListBox" Height="100" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="RemoveScheduleButton" Content="Remove Selected" Click="RemoveSchedule_Click" Padding="6,2"/>
                    <TextBlock x:Name="BandwidthNoteText" Text="Select an entry and click Remove to delete." Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- Add new schedule controls -->
                <GroupBox Header="Add New Schedule" Padding="4" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Start Hour:" VerticalAlignment="Center" Grid.Column="0"/>
                        <TextBox x:Name="ScheduleStartHourTextBox" Grid.Column="1" Margin="4,0,0,0"/>

                        <TextBlock Text="End Hour:" VerticalAlignment="Center" Grid.Column="2" Margin="8,0,0,0"/>
                        <TextBox x:Name="ScheduleEndHourTextBox" Grid.Column="3" Margin="4,0,0,0"/>

                        <TextBlock Text="Speed (KB/s):" VerticalAlignment="Center" Grid.Column="4" Margin="8,0,0,0"/>
                        <TextBox x:Name="ScheduleSpeedLimitTextBox" Grid.Column="5" Margin="4,0,0,0"/>

                        <Button x:Name="AddScheduleButton" Content="Add" Grid.Column="6" Margin="8,0,0,0" Click="AddSchedule_Click" Padding="6,2"/>
                    </Grid>
                </GroupBox>

                <TextBlock Text="Note: Schedules are checked hourly. Hours are 0-23 (24-hour format)." FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="⚡ Hardware-Aware RAM &amp; CPU Optimizer (Real-time)" Grid.Row="5" Margin="0,0,0,10" Padding="8">
            <StackPanel Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Adaptive Resource Management:" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SystemHardwareInfoText" Text="Detecting CPU &amp; RAM..." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="EDM RAM:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="CurrentEdmRamText" Text="28.4 MB" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="🧹 Free RAM Now" Padding="6,2" Click="FreeRamNow_Click"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Optimization Mode:" VerticalAlignment="Center" Width="140"/>
                    <ComboBox x:Name="ResourceOptimizerModeCombo" Width="280" SelectionChanged="ResourceOptimizerModeCombo_SelectionChanged">
                        <ComboBoxItem Content="🌱 Eco / Low-RAM Mode (Max 35 MB RAM, 4 Chunks)"/>
                        <ComboBoxItem Content="⚡ Balanced Smart Mode (Auto-Tuned by Hardware)" IsSelected="True"/>
                        <ComboBoxItem Content="🚀 Ultra High-Throughput (Max Speed, 32 Chunks)"/>
                    </ComboBox>
                </StackPanel>

                <CheckBox x:Name="AutoCompactRamCheckBox" Content="Auto-compact RAM when downloads complete or EDM idles" IsChecked="True" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" Grid.Row="6" HorizontalAlignment="Right">
            <Button Content="Save" Width="80" Click="Save_Click" Height="30"/>
            <Button Content="Cancel" Width="80" Click="Cancel_Click" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
