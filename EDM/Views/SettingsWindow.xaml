<Window x:Class="EDM.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — Exclusive Download Manager" Height="860" Width="680" 
        WindowStartupLocation="CenterOwner" 
        Background="{DynamicResource BackgroundBrush}" 
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Modern Input Box Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Brd" Property="BorderBrush" Value="#7C3AED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern PasswordBox Style -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource CardInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Brd" Property="BorderBrush" Value="#7C3AED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                <Setter TargetName="Brd" Property="BorderBrush" Value="#7C3AED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Gradient Button Style -->
        <Style x:Key="PrimaryGradientBtn" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#8B5CF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content Area (Scrollable) -->
            <RowDefinition Height="*"/>
            <!-- Bottom Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER BANNER ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="40" Height="40" Background="#7C3AED" CornerRadius="10" Margin="0,0,14,0">
                    <TextBlock Text="⚙️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Settings &amp; Engine Configuration" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Customize download directories, external binary tools, proxy, safety, and performance optimizer" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== SCROLLABLE SETTINGS CONTENT ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel Orientation="Vertical">

                <!-- 1. GENERAL & STORAGE -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="📁 Storage &amp; Conversion" FontSize="13" FontWeight="Bold" Foreground="#7C3AED" Margin="0,0,0,12"/>

                        <!-- Default Download Path -->
                        <TextBlock Text="Default Download Folder" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DefaultPathTextBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource ModernBtn}" Click="Browse_Click"/>
                        </Grid>

                        <CheckBox x:Name="AutoConvertCheckBox" Content="Auto-convert downloaded video to MP3 when requested" FontSize="12" Margin="0,0,0,8"/>
                        <CheckBox x:Name="SendCrashReportsCheckBox" Content="Send anonymous telemetry to help improve EDM stability" FontSize="12" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="🔑 Site Logins Vault..." Style="{StaticResource ModernBtn}" Margin="0,0,8,0" Click="OpenSiteLoginsManager_Click"/>
                            <Button Content="📁 Category Routing Rules..." Style="{StaticResource ModernBtn}" Margin="0,0,8,0" Click="OpenCategoryRulesEditor_Click"/>
                            <Button Content="📂 Crash Logs Folder" Style="{StaticResource ModernBtn}" Click="OpenCrashReportsFolder_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. EXTERNAL TOOLS & PROTOCOLS -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="⚡ External Engine &amp; Binary Tools" FontSize="13" FontWeight="Bold" Foreground="#7C3AED" Margin="0,0,0,12"/>

                        <!-- FFmpeg Path -->
                        <TextBlock Text="FFmpeg Binary Path" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FfmpegPathTextBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource ModernBtn}" Click="BrowseFfmpeg_Click"/>
                        </Grid>

                        <!-- yt-dlp Path -->
                        <TextBlock Text="yt-dlp Binary Path" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="YtDlpPathTextBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource ModernBtn}" Margin="0,0,8,0" Click="BrowseYtDlp_Click"/>
                            <Button Grid.Column="2" Content="Test" Style="{StaticResource ModernBtn}" Click="TestYtDlp_Click"/>
                        </Grid>

                        <!-- aria2c Path -->
                        <TextBlock Text="aria2c Engine Path" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="Aria2PathTextBox" Grid.Column="0" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Test" Style="{StaticResource ModernBtn}" Click="TestAria2_Click"/>
                        </Grid>

                        <!-- Default Format Args -->
                        <TextBlock Text="Default Format Arguments" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="FormatArgsTextBox" Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 3. CLIPBOARD MONITORING -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="📋 Clipboard URL Monitoring" FontSize="13" FontWeight="Bold" Foreground="#7C3AED" Margin="0,0,0,12"/>
                        <CheckBox x:Name="EnableClipboardMonitoringCheckBox" Content="Enable Windows Clipboard Monitoring for downloadable URLs" 
                                  FontSize="12" Margin="0,0,0,10" Checked="ClipboardMonitoringCheckBox_Changed" Unchecked="ClipboardMonitoringCheckBox_Changed"/>

                        <StackPanel x:Name="ClipboardOptionsPanel" Orientation="Vertical" IsEnabled="False">
                            <TextBlock Text="Supported Protocols to Detect:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox x:Name="ClipboardHttpCheckBox" Content="HTTP" IsChecked="True" FontSize="12" Margin="0,0,16,0"/>
                                <CheckBox x:Name="ClipboardHttpsCheckBox" Content="HTTPS" IsChecked="True" FontSize="12" Margin="0,0,16,0"/>
                                <CheckBox x:Name="ClipboardFtpCheckBox" Content="FTP / FTPS" IsChecked="True" FontSize="12" Margin="0,0,16,0"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="When URL is Detected:" VerticalAlignment="Center" FontSize="11" Grid.Column="0"/>
                                <ComboBox x:Name="ClipboardActionComboBox" Grid.Column="1" Height="32">
                                    <ComboBoxItem Content="Ask before downloading (Default)" IsSelected="True"/>
                                    <ComboBoxItem Content="Automatically download"/>
                                    <ComboBoxItem Content="Ignore"/>
                                </ComboBox>
                            </Grid>

                            <CheckBox x:Name="ClipboardIgnoreDuplicatesCheckBox" Content="Ignore duplicate URLs already detected or downloading" IsChecked="True" FontSize="12" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ClipboardShowNotificationCheckBox" Content="Show notification when a download link is detected from clipboard" IsChecked="True" FontSize="12" Margin="0,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 4. BROWSER INTEGRATION -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="🌐 Browser Integration &amp; Download Capture" FontSize="13" FontWeight="Bold" Foreground="#7C3AED" Margin="0,0,0,12"/>
                        <CheckBox x:Name="EnableBrowserIntegrationCheckBox" Content="Enable Browser Integration (Chrome, Edge, Firefox, Brave, Opera, Vivaldi)" 
                                  FontSize="12" Margin="0,0,0,10" Checked="BrowserIntegrationCheckBox_Changed" Unchecked="BrowserIntegrationCheckBox_Changed"/>

                        <StackPanel x:Name="BrowserOptionsPanel" Orientation="Vertical" IsEnabled="True">
                            <CheckBox x:Name="BrowserCaptureDownloadsCheckBox" Content="Automatically capture file downloads from browser" IsChecked="True" FontSize="12" Margin="0,0,0,8"/>
                            <CheckBox x:Name="BrowserShowConfirmationCheckBox" Content="Show download confirmation dialog before starting download" IsChecked="True" FontSize="12" Margin="0,0,0,8"/>
                            <CheckBox x:Name="BrowserShowNotificationCheckBox" Content="Show notification when a download is intercepted from browser" IsChecked="True" FontSize="12" Margin="0,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 5. URL SAFETY CHECKING -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="🛡️ URL Safety &amp; Antivirus Protection" FontSize="13" FontWeight="Bold" Foreground="#7C3AED" Margin="0,0,0,12"/>
                        <CheckBox x:Name="EnableSafetyCheckBox" Content="Check URLs with Google Safe Browsing API before downloading" 
                                  FontSize="12" Margin="0,0,0,8" Checked="SafetyEnabledCheckBox_Changed" Unchecked="SafetyEnabledCheckBox_Changed"/>

                        <StackPanel x:Name="SafetyOptionsPanel" Orientation="Vertical" IsEnabled="False">
                            <TextBlock Text="Google Safe Browsing API Key" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="ApiKeyPasswordBox" Grid.Column="0" Margin="0,0,10,0"/>
                                <TextBlock x:Name="ApiKeyStatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="#10B981" FontWeight="Bold" Text="✓ Configured"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 4. PROXY NETWORK SETTINGS -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="🌐 Network &amp; Proxy Configuration" FontSize="13" FontWeight="Bold" Foreground="#7C3AED" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ProxyEnabledCheckBox" Content="Route all download connections through proxy server" 
                                  FontSize="12" Margin="0,0,0,10" Checked="ProxyEnabledCheckBox_Changed" Unchecked="ProxyEnabledCheckBox_Changed"/>

                        <StackPanel x:Name="ProxyOptionsPanel" Orientation="Vertical" IsEnabled="False">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Type" FontSize="11" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ProxyTypeComboBox" Height="32">
                                        <ComboBoxItem Content="HTTP" IsSelected="True"/>
                                        <ComboBoxItem Content="HTTPS"/>
                                        <ComboBoxItem Content="SOCKS5"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Host / IP Address" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ProxyHostTextBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Port" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ProxyPortTextBox" Text="8080"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Username (Optional)" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ProxyUsernameTextBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Password (Optional)" FontSize="11" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="ProxyPasswordBox"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <CheckBox x:Name="ProxyBypassLocalCheckBox" Content="Bypass proxy for local LAN addresses" IsChecked="True" VerticalAlignment="Center"/>
                                <Button Content="Test Connection" Style="{StaticResource ModernBtn}" Margin="16,0,0,0" Click="TestProxy_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="ProxyTestResultText" Margin="0,6,0,0" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 5. WINDOWS EXPLORER INTEGRATION -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="🪟 Windows Explorer Shell Integration" FontSize="13" FontWeight="Bold" Foreground="#7C3AED" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Right-Click Context Menu:" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="ContextMenuStatusText" Text="Status: Active" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="ToggleContextMenuButton" Grid.Column="1" Content="Enable" Style="{StaticResource ModernBtn}" Width="100" Click="ToggleContextMenu_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 6. BANDWIDTH SCHEDULER -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="⏱️ Bandwidth Scheduling &amp; Speed Limits" FontSize="13" FontWeight="Bold" Foreground="#7C3AED" Margin="0,0,0,12"/>
                        <TextBlock Text="Active Time-Based Speed Schedules:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ListBox x:Name="BandwidthSchedulesListBox" Height="90" Background="{DynamicResource CardInputBg}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="RemoveScheduleButton" Content="Remove Selected" Style="{StaticResource ModernBtn}" Click="RemoveSchedule_Click"/>
                            <TextBlock x:Name="BandwidthNoteText" Text="Select a schedule entry and click Remove to delete." Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                        </StackPanel>

                        <!-- Add Schedule Grid -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Start (0-23):" VerticalAlignment="Center" Grid.Column="0" FontSize="11"/>
                            <TextBox x:Name="ScheduleStartHourTextBox" Grid.Column="1" Margin="6,0,8,0"/>

                            <TextBlock Text="End (0-23):" VerticalAlignment="Center" Grid.Column="2" FontSize="11"/>
                            <TextBox x:Name="ScheduleEndHourTextBox" Grid.Column="3" Margin="6,0,8,0"/>

                            <TextBlock Text="Limit (KB/s):" VerticalAlignment="Center" Grid.Column="4" FontSize="11"/>
                            <TextBox x:Name="ScheduleSpeedLimitTextBox" Grid.Column="5" Margin="6,0,8,0"/>

                            <Button x:Name="AddScheduleButton" Content="Add Schedule" Grid.Column="6" Style="{StaticResource ModernBtn}" Click="AddSchedule_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 7. HARDWARE-AWARE RAM & CPU OPTIMIZER -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="⚡ Hardware-Aware RAM &amp; CPU Optimizer (Real-Time)" FontSize="13" FontWeight="Bold" Foreground="#7C3AED" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Adaptive Resource Governor" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="SystemHardwareInfoText" Text="Detecting CPU &amp; RAM..." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="RAM:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="CurrentEdmRamText" Text="28.4 MB" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Content="🧹 Free RAM" Style="{StaticResource ModernBtn}" Click="FreeRamNow_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Optimization Mode:" VerticalAlignment="Center" FontSize="11" Grid.Column="0"/>
                            <ComboBox x:Name="ResourceOptimizerModeCombo" Grid.Column="1" Height="32" SelectionChanged="ResourceOptimizerModeCombo_SelectionChanged">
                                <ComboBoxItem Content="🌱 Eco / Low-RAM Mode (Max 35 MB RAM, 4 Chunks)"/>
                                <ComboBoxItem Content="⚡ Balanced Smart Mode (Auto-Tuned by Hardware)" IsSelected="True"/>
                                <ComboBoxItem Content="🚀 Ultra High-Throughput (Max Speed, 32 Chunks)"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="AutoCompactRamCheckBox" Content="Auto-compact RAM when downloads complete or EDM idles" IsChecked="True" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ==================== FOOTER ACTIONS ==================== -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save Settings" Style="{StaticResource PrimaryGradientBtn}" Width="130" Margin="0,0,10,0" Click="Save_Click"/>
                <Button Content="Cancel" Style="{StaticResource ModernBtn}" Width="100" Click="Cancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
