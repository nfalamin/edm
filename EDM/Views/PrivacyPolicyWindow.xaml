<Window x:Class="EDM.Views.PrivacyPolicyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Privacy Policy &amp; Legal Center — EDM" Height="700" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content Split -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#10B981" Margin="0,0,12,0">
                        <TextBlock Text="🛡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Privacy Policy &amp; Legal Agreements" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="PolicyVersionText" Text="Policy Version 2.6" FontSize="11" Foreground="#10B981" FontWeight="SemiBold" Margin="0,0,12,0"/>
                            <TextBlock x:Name="LastUpdatedText" Text="Last Updated: August 16, 2026" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Search Input -->
                <Border Grid.Column="2" Background="{DynamicResource SecondaryBackgroundBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,0" Height="36" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="SearchBox" Background="Transparent" BorderThickness="0" 
                                 Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged" CaretBrush="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Grid.Column="1" x:Name="SearchWatermark" Text="Search policy terms..." 
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Button Grid.Column="2" x:Name="ClearSearchBtn" Content="✕" Background="Transparent" BorderThickness="0" 
                                Foreground="{DynamicResource SecondaryTextBrush}" Cursor="Hand" Visibility="Collapsed" Click="ClearSearch_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT SPLIT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/> <!-- TOC Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Policy Viewer -->
            </Grid.ColumnDefinitions>

            <!-- LEFT TABLE OF CONTENTS -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="TABLE OF CONTENTS (29)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TOCPanel" Margin="8,8,8,12">
                            <!-- Populated in code-behind -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT POLICY DOCUMENT VIEWER -->
            <ScrollViewer Grid.Column="1" x:Name="PolicyScrollViewer" VerticalScrollBarVisibility="Auto" Padding="24,18">
                <StackPanel x:Name="PolicySectionsPanel" Orientation="Vertical">
                    <!-- Populated in code-behind with 27 rich policy sections -->
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Button Content="📋 Copy Policy to Clipboard" Background="{DynamicResource NavHoverBg}" 
                        Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" Cursor="Hand" HorizontalAlignment="Left" Padding="12,6" Click="CopyPolicy_Click"/>
                <Button Content="Close" Width="90" Height="30" HorizontalAlignment="Right" 
                        Background="{DynamicResource NavHoverBg}" Foreground="{DynamicResource PrimaryTextBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
