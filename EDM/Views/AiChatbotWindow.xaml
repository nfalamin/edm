<Window x:Class="EDM.Views.AiChatbotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EDM AI Assistant — 100% Offline" Height="680" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Quick Prompt Chips -->
            <RowDefinition Height="*"/>    <!-- Chat Stream -->
            <RowDefinition Height="Auto"/> <!-- Input Box -->
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- AI Avatar & Title -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#8B4DFF" Offset="0"/>
                            <GradientStop Color="#06B6D4" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#8B4DFF" BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
                    </Border.Effect>
                    <TextBlock Text="🤖" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="EDM AI Assistant" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Border Background="#10B981" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="100% OFFLINE" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Instant intelligent troubleshooting, live state diagnostics &amp; multi-threaded optimization" 
                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Top Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🗑️ Clear Chat" Background="Transparent" Foreground="{DynamicResource SecondaryTextBrush}" 
                            BorderThickness="0" Cursor="Hand" FontSize="11" Margin="0,0,8,0" Click="ClearChat_Click"/>
                    <Button Content="✕" Width="30" Height="30" Background="{DynamicResource NavHoverBg}" 
                            Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" Cursor="Hand" Click="Close_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- QUICK PROMPT SUGGESTION CHIPS -->
        <Border Grid.Row="1" Background="{DynamicResource SecondaryBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="QuickPromptsPanel" Orientation="Horizontal">
                    <!-- Populated dynamically based on language -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- CHAT CONVERSATION STREAM -->
        <ScrollViewer Grid.Row="2" x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel x:Name="MessagesPanel" Orientation="Vertical">
                <!-- Message bubbles rendered dynamically in code-behind -->
            </StackPanel>
        </ScrollViewer>

        <!-- INPUT BAR -->
        <Border Grid.Row="3" Background="{DynamicResource HeaderBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Input Text Box -->
                <Border Grid.Column="0" Background="{DynamicResource CardInputBg}" BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" CornerRadius="10" Padding="12,0" Height="44" Margin="0,0,10,0">
                    <Grid>
                        <TextBox x:Name="UserInputTextBox" Background="Transparent" BorderThickness="0" 
                                 Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" VerticalAlignment="Center"
                                 CaretBrush="{DynamicResource PrimaryTextBrush}" TextChanged="UserInputTextBox_TextChanged"
                                 KeyDown="UserInputTextBox_KeyDown"/>
                        <TextBlock x:Name="InputWatermark" Text="Ask EDM AI anything about downloads, speeds, video extraction, or errors..." 
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Send Button -->
                <Button x:Name="SendBtn" Grid.Column="1" Width="54" Height="44" Background="#8B4DFF" 
                        Foreground="White" FontWeight="Bold" FontSize="16" BorderThickness="0" Cursor="Hand" Click="SendBtn_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="➤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
