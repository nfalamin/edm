<Window x:Class="EDM.Views.SiteLoginsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Site Logins &amp; Passwords Manager"
        Height="450" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Saved Site Credentials (DPAPI Encrypted)"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Margin="0,0,0,12" />

        <DataGrid Grid.Row="1"
                  x:Name="CredentialsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Background="{DynamicResource SecondaryBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  Foreground="{DynamicResource PrimaryTextBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Site URL / Host" Binding="{Binding Hostname}" Width="250" />
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="180" />
                <DataGridTextColumn Header="Password" Binding="{Binding MaskedPassword}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Input Box for New Entry -->
        <Border Grid.Row="2"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,12,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="SiteBox" Margin="2" Padding="4" ToolTip="Site (e.g. https://files.com)" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                <TextBox Grid.Column="1" x:Name="UserBox" Margin="2" Padding="4" ToolTip="Username" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                <PasswordBox Grid.Column="2" x:Name="PassBox" Margin="2" Padding="4" ToolTip="Password" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                <Button Grid.Column="3" Content="Add / Save" Click="OnAddCredential" Margin="4,2,2,2" Padding="12,4" Background="{DynamicResource AccentColorBrush}" Foreground="White" />
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Delete Selected" Click="OnDeleteSelected" Margin="0,0,8,0" Padding="12,6" />
            <Button Content="Close" Click="OnClose" Padding="16,6" />
        </StackPanel>
    </Grid>
</Window>
