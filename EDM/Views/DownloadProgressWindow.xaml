<Window x:Class="EDM.Views.DownloadProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Download Status"
        Width="760" Height="580"
        MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0B1120"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <!-- High-Contrast Explicit Dark Theme Brushes -->
            <SolidColorBrush x:Key="DlgBg" Color="#0B1120"/>
            <SolidColorBrush x:Key="DlgCardBg" Color="#131D31"/>
            <SolidColorBrush x:Key="DlgHeaderBg" Color="#0D1527"/>
            <SolidColorBrush x:Key="DlgInputBg" Color="#080E1A"/>
            <SolidColorBrush x:Key="DlgBorder" Color="#223354"/>
            <SolidColorBrush x:Key="DlgBorderHover" Color="#6366F1"/>
            <SolidColorBrush x:Key="DlgTextPrimary" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DlgTextSecondary" Color="#94A3B8"/>
            <SolidColorBrush x:Key="DlgTextMuted" Color="#64748B"/>
            <SolidColorBrush x:Key="DlgAccent" Color="#6366F1"/>
            <SolidColorBrush x:Key="DlgAccentGlow" Color="#8B5CF6"/>
            <SolidColorBrush x:Key="DlgSuccess" Color="#10B981"/>

            <!-- Linear Gradient Brushes — Vivid Emerald → Cyan → Indigo -->
            <LinearGradientBrush x:Key="GlowPillGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00C9A7" Offset="0.0"/>
                <GradientStop Color="#0EA5E9" Offset="0.55"/>
                <GradientStop Color="#6366F1" Offset="1.0"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="EmeraldPillGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#10B981" Offset="0.0"/>
                <GradientStop Color="#059669" Offset="1.0"/>
            </LinearGradientBrush>

            <!-- Vivid Real-Time Segment Progress Bar — correct WPF PART_Track/PART_Indicator -->
            <Style x:Key="SegmentProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="7"/>
                <Setter Property="Background" Value="#0D1830"/>
                <Setter Property="Foreground">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00C9A7" Offset="0.0"/>
                            <GradientStop Color="#0EA5E9" Offset="0.55"/>
                            <GradientStop Color="#6366F1" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="PART_Track" SnapsToDevicePixels="True" ClipToBounds="True">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- TitleBar Button Style -->
            <Style x:Key="TitleBarButton" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#94A3B8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Modern Primary Button Style -->
            <Style x:Key="ModernPrimaryButton" TargetType="Button">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Background" Value="{StaticResource GlowPillGradient}"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBrd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#6366F1" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBrd" Property="Opacity" Value="0.95"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Outline Button Style -->
            <Style x:Key="ModernOutlineButton" TargetType="Button">
                <Setter Property="Foreground" Value="#F8FAFC"/>
                <Setter Property="Background" Value="#1A263D"/>
                <Setter Property="BorderBrush" Value="{StaticResource DlgBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SecBrd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SecBrd" Property="Background" Value="#243352"/>
                                    <Setter TargetName="SecBrd" Property="BorderBrush" Value="#6366F1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="SecBrd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Custom High-Contrast ComboBox Style for Speed Limiter -->
            <Style x:Key="ModernDarkComboBox" TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource DlgInputBg}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="{StaticResource DlgBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" 
                                              Focusable="False" 
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleBorder" 
                                                    Background="{StaticResource DlgInputBg}" 
                                                    BorderBrush="{StaticResource DlgBorder}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="26"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path x:Name="Arrow" 
                                                          Grid.Column="1" 
                                                          HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center" 
                                                          Data="M 0 0 L 3.5 3.5 L 7 0 Z" 
                                                          Fill="#94A3B8"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#6366F1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter x:Name="ContentSite" 
                                                  IsHitTestVisible="False" 
                                                  Content="{TemplateBinding SelectionBoxItem}" 
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                                  Margin="10,0,26,0" 
                                                  VerticalAlignment="Center" 
                                                  HorizontalAlignment="Left">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="FontSize" Value="11.5"/>
                                            <Setter Property="FontWeight" Value="Medium"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>

                                <Popup x:Name="Popup" 
                                       Placement="Bottom" 
                                       IsOpen="{TemplateBinding IsDropDownOpen}" 
                                       AllowsTransparency="True" 
                                       Focusable="False" 
                                       PopupAnimation="Slide">
                                    <Grid x:Name="DropDown" 
                                          MinWidth="{TemplateBinding ActualWidth}" 
                                          MaxHeight="180">
                                        <Border x:Name="DropDownBorder" 
                                                Background="#0D1527" 
                                                BorderBrush="{StaticResource DlgBorder}" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Margin="0,3,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.6"/>
                                            </Border.Effect>
                                            <ScrollViewer Margin="4,4" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ComboBoxItem Style -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1E293B"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#6366F1"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Custom Ultra-Sleek Modern Dark ScrollBar Style -->
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
                <Setter Property="Width" Value="5"/>
                <Setter Property="MinWidth" Value="5"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="true">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Border CornerRadius="2.5" Background="#334155" Margin="0,2"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern High-Contrast ScrollViewer Style -->
            <Style TargetType="{x:Type ScrollViewer}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                            <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" 
                                                       CanContentScroll="{TemplateBinding CanContentScroll}" 
                                                       CanHorizontallyScroll="False" 
                                                       CanVerticallyScroll="False" 
                                                       ContentTemplate="{TemplateBinding ContentTemplate}" 
                                                       Content="{TemplateBinding Content}" 
                                                       Grid.Column="0" 
                                                       Grid.Row="0" 
                                                       Margin="{TemplateBinding Padding}"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar" 
                                           AutomationProperties.AutomationId="VerticalScrollBar" 
                                           Cursor="Arrow" 
                                           Grid.Column="1" 
                                           Maximum="{TemplateBinding ScrollableHeight}" 
                                           Minimum="0" 
                                           Grid.Row="0" 
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" 
                                           Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Margin="0,4,3,4"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{StaticResource DlgBorder}" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0D1527" Offset="0.0"/>
                <GradientStop Color="#0B1120" Offset="0.4"/>
                <GradientStop Color="#080E1A" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="40" />
                <!-- Content Area -->
                <RowDefinition Height="*" />
                <!-- Bottom Action Controls -->
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <!-- Custom Drag Title Bar -->
            <Grid Grid.Row="0" Background="{StaticResource DlgHeaderBg}" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Background="#202A4A" CornerRadius="6" Padding="6,4" Margin="0,0,8,0">
                        <TextBlock Text="⚡" FontSize="13" Foreground="#818CF8" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="EDM Turbo Downloader" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="WindowTitleText" Grid.Column="1" Text="0.0% - download_file.ext" FontSize="12" Foreground="{StaticResource DlgTextSecondary}" TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click">━</Button>
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarButton}" Click="CloseButton_Click">✕</Button>
                </StackPanel>
            </Grid>

            <!-- Scrollable Content Area with Sleek Dark Scrollbar -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12">
                <StackPanel Orientation="Vertical">

                    <!-- Header Card: File Name, Category Icon, Status Badge -->
                    <Border Background="{StaticResource DlgCardBg}" BorderBrush="{StaticResource DlgBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="#1E293B" VerticalAlignment="Center">
                                <TextBlock x:Name="FileCategoryIconText" Text="📁" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                <TextBlock x:Name="FileNameText" Text="download_file.dat" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="UrlSubtitleText" Text="https://..." FontSize="11.5" Foreground="{StaticResource DlgTextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border x:Name="StatusBadgeBorder" Grid.Column="2" CornerRadius="12" Background="#1E3E62" Padding="14,6" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusBadgeText" Text="Connecting..." FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Error Alert Card (Visible only on error) -->
                    <Border x:Name="ErrorAlertCard" Visibility="Collapsed" Background="#2E1018" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ErrorMessageText" Grid.Column="1" Text="Download Error occurred." Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button x:Name="RetryButton" Grid.Column="2" Content="Retry" Click="RetryButton_Click" Style="{StaticResource ModernOutlineButton}" Height="28" Padding="10,0" Margin="6,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Progress Bar & High-Level KPIs -->
                    <Border Background="{StaticResource DlgCardBg}" BorderBrush="{StaticResource DlgBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Progress Bar Row — sleek 10px height -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Custom High-Res Sleek Glowing Progress Bar (10px height) -->
                                <Grid x:Name="ProgressBarContainer" Grid.Column="0" Height="10">
                                    <Border CornerRadius="5" Background="{StaticResource DlgInputBg}" BorderBrush="{StaticResource DlgBorder}" BorderThickness="1">
                                        <Grid ClipToBounds="True">
                                            <Border x:Name="ProgressIndicator" Background="{StaticResource GlowPillGradient}" CornerRadius="4" Width="0" HorizontalAlignment="Left" />
                                        </Grid>
                                    </Border>
                                </Grid>
                                <ProgressBar x:Name="OverallProgressBar" Visibility="Collapsed" Minimum="0" Maximum="100" Value="0" />

                                <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Text="0.0%" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="12,0,0,0" VerticalAlignment="Center" Width="60" TextAlignment="Right"/>
                            </Grid>

                            <!-- Progress Subtitle (Downloaded of Total, Time Left) -->
                            <Grid Margin="2,0,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Downloaded: " Foreground="{StaticResource DlgTextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="DownloadedText" Text="0 B of 0 B" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Time Left: " Foreground="{StaticResource DlgTextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="TimeLeftText" Text="Calculating..." Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Real-Time Telemetry Matrix (Clean Balanced 5-Column Grid) -->
                    <Border Background="{StaticResource DlgCardBg}" BorderBrush="{StaticResource DlgBorder}" BorderThickness="1" CornerRadius="10" Padding="8,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Col 0: Speed -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="16" Background="#112447" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="⬇" FontSize="13" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Speed" FontSize="10" Foreground="{StaticResource DlgTextSecondary}" FontWeight="Medium"/>
                                    <TextBlock x:Name="SpeedText" Text="0.0 MB/s" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Col 1: Average Speed -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="16" Background="#064E3B" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="⏱" FontSize="13" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Avg Speed" FontSize="10" Foreground="{StaticResource DlgTextSecondary}" FontWeight="Medium"/>
                                    <TextBlock x:Name="SpeedAvgText" Text="0.0 MB/s" FontSize="12" FontWeight="Bold" Foreground="#10B981" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Col 2: Peak Speed -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="16" Background="#2E1065" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="📈" FontSize="13" Foreground="#A855F7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Peak Speed" FontSize="10" Foreground="{StaticResource DlgTextSecondary}" FontWeight="Medium"/>
                                    <TextBlock x:Name="SpeedPeakText" Text="0.0 MB/s" FontSize="12" FontWeight="Bold" Foreground="#A855F7" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Col 3: Connections -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="16" Background="#0C364F" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="🌐" FontSize="13" Foreground="#818CF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Connections" FontSize="10" Foreground="{StaticResource DlgTextSecondary}" FontWeight="Medium"/>
                                    <TextBlock x:Name="ConnectionsCountText" Text="8 Active" FontSize="12" FontWeight="Bold" Foreground="#818CF8" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Col 4: Resume Support -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="16" Background="#064E3B" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="🔄" FontSize="13" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Resume" FontSize="10" Foreground="{StaticResource DlgTextSecondary}" FontWeight="Medium"/>
                                    <TextBlock x:Name="ResumeCapabilityText" Text="Supported" FontSize="12" FontWeight="Bold" Foreground="#10B981" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <!-- Real-Time Transfer Graph — compact 54px -->
                    <Border Background="{StaticResource DlgCardBg}" BorderBrush="{StaticResource DlgBorder}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="LIVE THROUGHPUT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource DlgTextSecondary}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#00C9A7" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="Speed" FontSize="9" Foreground="{StaticResource DlgTextSecondary}" Margin="0,0,8,0"/>
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#F59E0B" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="Avg" FontSize="9" Foreground="{StaticResource DlgTextSecondary}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Dynamic Graph Canvas — compact 54px height -->
                            <Border Height="54" Background="{StaticResource DlgInputBg}" CornerRadius="8" BorderBrush="{StaticResource DlgBorder}" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <!-- Background Grid Lines -->
                                    <Canvas x:Name="GraphGridCanvas" IsHitTestVisible="False"/>
                                    <!-- Live Throughput Polyline / Polygon -->
                                    <Canvas x:Name="TransferGraphCanvas" IsHitTestVisible="False"/>
                                    <!-- Top Right Live Graph Peak Marker -->
                                    <TextBlock x:Name="GraphPeakOverlayText" Text="Peak: 0 B/s" FontSize="9.5" Foreground="#F59E0B" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,6,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Real Segment Connection Table -->
                    <Border Background="{StaticResource DlgCardBg}" BorderBrush="{StaticResource DlgBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ACTIVE SEGMENT TELEMETRY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DlgTextSecondary}"/>
                                <Button x:Name="ToggleConnectionsButton" Content="Hide Details" Click="ToggleConnectionsButton_Click" Style="{StaticResource ModernOutlineButton}" Height="24" Padding="10,0" FontSize="10.5"/>
                            </Grid>

                            <!-- Segment Overview Progress Strip -->
                            <Border Background="{StaticResource DlgInputBg}" BorderBrush="{StaticResource DlgBorder}" BorderThickness="1" CornerRadius="6" Height="14" Margin="0,0,0,10">
                                <ItemsControl ItemsSource="{Binding Connections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="1,1" CornerRadius="3" Background="{Binding StatusColor}" ToolTip="{Binding ByteRangeText}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Detailed Connection List -->
                            <ItemsControl x:Name="ConnectionsItemsControl" ItemsSource="{Binding Connections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2" Background="{StaticResource DlgInputBg}" BorderBrush="{StaticResource DlgBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="8" Height="8" CornerRadius="4" Background="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ConnectionNumber, StringFormat='Thread #{0}'}" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                                    <ProgressBar Value="{Binding IndividualProgress}" Maximum="100" Style="{StaticResource SegmentProgressBarStyle}"/>
                                                </Grid>

                                                <TextBlock Grid.Column="2" Text="{Binding DownloadedAmount}" ToolTip="{Binding RemainingAmount}" Foreground="{StaticResource DlgTextSecondary}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding ThreadSpeed}" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action Controls -->
            <Border Grid.Row="2" Background="{StaticResource DlgHeaderBg}" BorderBrush="{StaticResource DlgBorder}" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="Speed Limit:" Foreground="{StaticResource DlgTextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="SpeedLimitComboBox" Style="{StaticResource ModernDarkComboBox}" Width="130" SelectedIndex="0" SelectionChanged="SpeedLimitComboBox_SelectionChanged">
                            <ComboBoxItem Content="Unlimited"/>
                            <ComboBoxItem Content="500 KB/s"/>
                            <ComboBoxItem Content="1.0 MB/s"/>
                            <ComboBoxItem Content="2.0 MB/s"/>
                            <ComboBoxItem Content="5.0 MB/s"/>
                            <ComboBoxItem Content="10.0 MB/s"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="CopyUrlButton" Content="📋 Copy URL" Click="CopyUrlButton_Click" Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,0"/>
                        <Button x:Name="PauseResumeButton" Content="⏸ Pause" Click="PauseButton_Click" Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,0"/>
                        <Button x:Name="OpenFileButton" Content="📂 Open File" Click="OpenFileButton_Click" Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,0" IsEnabled="False"/>
                        <Button x:Name="CancelButton" Content="✕ Cancel" Click="CancelButton_Click" Style="{StaticResource ModernPrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>