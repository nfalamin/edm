<Window x:Class="EDM.Views.DownloadProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Status"
        Width="740" Height="560"
        MinWidth="700" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="/Themes/ThemeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- TitleBar Button Style -->
            <Style x:Key="TitleBarButton" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#253556"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Modern Primary Button Style -->
            <Style x:Key="ModernPrimaryButton" TargetType="Button">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Background" Value="{DynamicResource PrimaryPillGradient}"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.9"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Modern Outline Button Style -->
            <Style x:Key="ModernOutlineButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource NavHoverBg}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Custom High-Contrast ComboBox Style for Speed Limiter -->
            <Style x:Key="ModernDarkComboBox" TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource CardInputBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" 
                                              Focusable="False" 
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleBorder" 
                                                    Background="{DynamicResource CardInputBg}" 
                                                    BorderBrush="{DynamicResource BorderBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="22"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path x:Name="Arrow" 
                                                          Grid.Column="1" 
                                                          HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center" 
                                                          Data="M 0 0 L 3.5 3.5 L 7 0 Z" 
                                                          Fill="{DynamicResource SecondaryTextBrush}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter x:Name="ContentSite" 
                                                  IsHitTestVisible="False" 
                                                  Content="{TemplateBinding SelectionBoxItem}" 
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                                  Margin="8,0,22,0" 
                                                  VerticalAlignment="Center" 
                                                  HorizontalAlignment="Left">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontWeight" Value="Medium"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>

                                <Popup x:Name="Popup" 
                                       Placement="Bottom" 
                                       IsOpen="{TemplateBinding IsDropDownOpen}" 
                                       AllowsTransparency="True" 
                                       Focusable="False" 
                                       PopupAnimation="Slide">
                                    <Grid x:Name="DropDown" 
                                          MinWidth="{TemplateBinding ActualWidth}" 
                                          MaxHeight="180">
                                        <Border x:Name="DropDownBorder" 
                                                Background="{DynamicResource CardBrush}" 
                                                BorderBrush="{DynamicResource BorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Margin="0,3,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.5"/>
                                            </Border.Effect>
                                            <ScrollViewer Margin="2,4" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ComboBoxItem Style -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="0,1">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="38" />
                <!-- Content Area -->
                <RowDefinition Height="*" />
                <!-- Bottom Action Controls -->
                <RowDefinition Height="54" />
            </Grid.RowDefinitions>

            <!-- Custom Drag Title Bar -->
            <Grid Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="⚡" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FBBF24"/>
                    <TextBlock Text="EDM Download Manager" FontSize="12.5" FontWeight="Bold" Foreground="#F4F7FF" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="WindowTitleText" Grid.Column="1" Text="0% - download_file.ext" FontSize="12" Foreground="#CBD5E1" TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click">━</Button>
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarButton}" Click="CloseButton_Click">✕</Button>
                </StackPanel>
            </Grid>

            <!-- Scrollable Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,10">
                <StackPanel Orientation="Vertical">

                    <!-- Header Card: File Name, Category Icon, Status Badge -->
                    <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6" Background="#1E2F56" VerticalAlignment="Center">
                                <TextBlock x:Name="FileCategoryIconText" Text="📁" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock x:Name="FileNameText" Text="download_file.dat" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="UrlSubtitleText" Text="https://..." FontSize="11" Foreground="{DynamicResource MutedTextColor}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </StackPanel>

                            <Border x:Name="StatusBadgeBorder" Grid.Column="2" CornerRadius="12" Background="#1E3E62" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusBadgeText" Text="Connecting..." FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Error Alert Card (Visible only on error) -->
                    <Border x:Name="ErrorAlertCard" Visibility="Collapsed" Background="#2E1018" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ErrorMessageText" Grid.Column="1" Text="Download Error occurred." Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button x:Name="RetryButton" Grid.Column="2" Content="Retry" Click="RetryButton_Click" Style="{StaticResource ModernOutlineButton}" Height="26" Padding="8,0" Margin="6,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Progress Bar & High-Level KPIs -->
                    <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Progress Bar Row -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Custom High-Res Rounded Glowing Progress Bar -->
                                <Grid x:Name="ProgressBarContainer" Grid.Column="0" Height="16">
                                    <Border CornerRadius="8" Background="#0A1124" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid ClipToBounds="True">
                                            <Border x:Name="ProgressIndicator" Background="{DynamicResource PrimaryPillGradient}" CornerRadius="7" Width="0" HorizontalAlignment="Left" />
                                        </Grid>
                                    </Border>
                                </Grid>
                                <!-- Backward compatible hidden standard progress bar -->
                                <ProgressBar x:Name="OverallProgressBar" Visibility="Collapsed" Minimum="0" Maximum="100" Value="0" />

                                <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Text="0.0%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" Width="55" TextAlignment="Right"/>
                            </Grid>

                            <!-- Progress Subtitle (Downloaded of Total, Time Left) -->
                            <Grid Margin="2,0,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Downloaded: " Foreground="{DynamicResource MutedTextColor}" FontSize="12"/>
                                    <TextBlock x:Name="DownloadedText" Text="0 B of 0 B" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Time Left: " Foreground="{DynamicResource MutedTextColor}" FontSize="12"/>
                                    <TextBlock x:Name="TimeLeftText" Text="Calculating..." Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Real-Time Telemetry Matrix (5-Column Cards matching Reference Image 1) -->
                    <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,10" Margin="0,0,0,10">
                        <UniformGrid Columns="5">

                            <!-- Col 1: Download Speed -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0" HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#112447" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="⬇" FontSize="14" Foreground="#3B9BFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Speed" FontSize="10" Foreground="#A9B7CC" FontWeight="Medium"/>
                                    <TextBlock x:Name="SpeedText" Text="0.0 MB/s" FontSize="12.5" FontWeight="Bold" Foreground="#3B9BFF" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Col 2: Average Speed -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0" HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#064E3B" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="⏱" FontSize="14" Foreground="#18D68A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Avg Speed" FontSize="10" Foreground="#A9B7CC" FontWeight="Medium"/>
                                    <TextBlock x:Name="SpeedAvgText" Text="0.0 MB/s" FontSize="12.5" FontWeight="Bold" Foreground="#18D68A" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Col 3: Peak Speed -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0" HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#2E1065" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="📈" FontSize="14" Foreground="#A56BFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Peak Speed" FontSize="10" Foreground="#A9B7CC" FontWeight="Medium"/>
                                    <TextBlock x:Name="SpeedPeakText" Text="0.0 MB/s" FontSize="12.5" FontWeight="Bold" Foreground="#A56BFF" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Col 4: Connections -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0" HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#0C364F" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="🌐" FontSize="14" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Connections" FontSize="10" Foreground="#A9B7CC" FontWeight="Medium"/>
                                    <TextBlock x:Name="ConnectionsCountText" Text="8 Active" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Col 5: Resume Support -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0" HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="18" Background="#064E3B" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="🔄" FontSize="14" Foreground="#18D68A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Resume" FontSize="10" Foreground="#A9B7CC" FontWeight="Medium"/>
                                    <TextBlock x:Name="ResumeCapabilityText" Text="Yes (206)" FontSize="12.5" FontWeight="Bold" Foreground="#18D68A" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                        </UniformGrid>
                    </Border>

                    <!-- Real-Time Transfer Graph -->
                    <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="LIVE THROUGHPUT GRAPH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#6366F1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Speed" FontSize="10" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,10,0"/>
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#F59E0B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Avg" FontSize="10" Foreground="{DynamicResource MutedTextColor}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Dynamic Graph Canvas -->
                            <Border Height="80" Background="#070D1E" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <!-- Background Grid Lines -->
                                    <Canvas x:Name="GraphGridCanvas" IsHitTestVisible="False"/>
                                    <!-- Live Throughput Polyline / Polygon -->
                                    <Canvas x:Name="TransferGraphCanvas" IsHitTestVisible="False"/>
                                    <!-- Top Right Live Graph Peak Marker -->
                                    <TextBlock x:Name="GraphPeakOverlayText" Text="Peak: 0 B/s" FontSize="10" Foreground="#F59E0B" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Real Segment Connection Table -->
                    <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ACTIVE SEGMENT TELEMETRY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextColor}"/>
                                <Button x:Name="ToggleConnectionsButton" Content="Hide Details" Click="ToggleConnectionsButton_Click" Style="{StaticResource ModernOutlineButton}" Height="22" Padding="8,0" FontSize="10"/>
                            </Grid>

                            <!-- Segment Overview Progress Strip -->
                            <Border Background="#0A1124" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Height="14" Margin="0,0,0,8">
                                <ItemsControl ItemsSource="{Binding Connections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Margin="0,1">
                                                <ProgressBar Value="{Binding IndividualProgress}" Minimum="0" Maximum="100" Background="Transparent" Foreground="#10B981" BorderThickness="0"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Segment Detail ListView -->
                            <ListView x:Name="ConnectionsListView" Height="110" ItemsSource="{Binding Connections}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="2"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Segment Index -->
                                            <TextBlock Text="{Binding ConnectionNumber, StringFormat='#{0}'}" Grid.Column="0" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>

                                            <!-- Range Description -->
                                            <TextBlock Text="{Binding ByteRangeText}" Grid.Column="1" Foreground="{DynamicResource MutedTextColor}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <!-- Downloaded -->
                                            <TextBlock Text="{Binding DownloadedAmount}" Grid.Column="2" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center"/>

                                            <!-- Speed -->
                                            <TextBlock Text="{Binding ThreadSpeed}" Grid.Column="3" Foreground="#10B981" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>

                                            <!-- State -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="6" Height="6" CornerRadius="3" Background="{Binding StatusColor}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding InfoStatus}" Foreground="{Binding StatusColor}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Progress % -->
                                            <TextBlock Text="{Binding IndividualProgress, StringFormat='{}{0}%'}" Grid.Column="5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action Controls Bar -->
            <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Per-Download Speed Limiter -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Speed Limit:" Foreground="{DynamicResource MutedTextColor}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                        <ComboBox x:Name="SpeedLimitComboBox" 
                                  Style="{StaticResource ModernDarkComboBox}"
                                  Width="120"
                                  SelectionChanged="SpeedLimitComboBox_SelectionChanged">
                            <ComboBoxItem Content="Unlimited" IsSelected="True"/>
                            <ComboBoxItem Content="100 KB/s"/>
                            <ComboBoxItem Content="250 KB/s"/>
                            <ComboBoxItem Content="500 KB/s"/>
                            <ComboBoxItem Content="1 MB/s"/>
                            <ComboBoxItem Content="2 MB/s"/>
                            <ComboBoxItem Content="5 MB/s"/>
                            <ComboBoxItem Content="10 MB/s"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Center Auxiliary Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="OpenFileButton" Content="▶ Open File" Click="OpenFileButton_Click" Style="{StaticResource ModernOutlineButton}" Height="28" Padding="10,0" Margin="4,0" IsEnabled="False"/>
                        <Button x:Name="OpenFolderButton" Content="📁 Open Folder" Click="OpenFolderButton_Click" Style="{StaticResource ModernOutlineButton}" Height="28" Padding="10,0" Margin="4,0"/>
                        <Button x:Name="CopyUrlButton" Content="📋 Copy URL" Click="CopyUrlButton_Click" Style="{StaticResource ModernOutlineButton}" Height="28" Padding="10,0" Margin="4,0"/>
                    </StackPanel>

                    <!-- Right Primary Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="PauseResumeButton" Content="⏸ Pause" Click="PauseButton_Click" Style="{StaticResource ModernPrimaryButton}" Width="95" Margin="0,0,8,0"/>
                        <Button x:Name="CancelButton" Content="✕ Cancel" Click="CancelButton_Click" Style="{StaticResource ModernOutlineButton}" Width="85"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>