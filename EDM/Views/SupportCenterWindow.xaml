<Window x:Class="EDM.Views.SupportCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EDM Support &amp; Help Center" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Main Body Split -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#8B4DFF" Margin="0,0,12,0">
                        <TextBlock Text="❓" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="EDM Support &amp; Knowledge Base" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="32 Comprehensive Troubleshooting Categories &amp; Interactive Guides" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search Input -->
                <Border Grid.Column="2" Background="{DynamicResource SecondaryBackgroundBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,0" Height="36" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="SearchBox" Background="Transparent" BorderThickness="0" 
                                 Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged" CaretBrush="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Grid.Column="1" x:Name="SearchWatermark" Text="Search issues, errors, or topics..." 
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Button Grid.Column="2" x:Name="ClearSearchBtn" Content="✕" Background="Transparent" BorderThickness="0" 
                                Foreground="{DynamicResource SecondaryTextBrush}" Cursor="Hand" Visibility="Collapsed" Click="ClearSearch_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN SPLIT (Categories Sidebar + Content Area) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/> <!-- Category Tree -->
                <ColumnDefinition Width="*"/>   <!-- Article Listing or Detail -->
            </Grid.ColumnDefinitions>

            <!-- LEFT CATEGORY SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="HELP TOPICS (32)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CategoryListPanel" Margin="8,8,8,12">
                            <!-- Populated in code-behind -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT CONTENT PANE -->
            <Grid Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
                <!-- VIEW 1: ARTICLE LIST -->
                <Grid x:Name="ArticleListView" Visibility="Visible" Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock x:Name="CurrentCategoryTitle" Text="All Troubleshooting Guides" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="CurrentCategoryDesc" Text="Select any guide below to view step-by-step diagnostic and resolution steps." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ArticleCardsPanel" Orientation="Vertical">
                            <!-- Populated in code-behind -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 2: ARTICLE DETAIL -->
                <Grid x:Name="ArticleDetailView" Visibility="Collapsed" Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Back Button Row -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="← Back to Articles" Padding="10,5" Background="{DynamicResource NavHoverBg}" 
                                Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" Cursor="Hand" Click="BackToList_Click"/>
                        <Border x:Name="DetailCategoryBadge" Background="#8B4DFF" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailCategoryBadgeText" Text="Category" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical">
                            <!-- Title & Summary -->
                            <TextBlock x:Name="DetailTitleText" Text="Article Title" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailSummaryText" Text="Summary description" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,16" TextWrapping="Wrap"/>

                            <!-- Section: Possible Causes -->
                            <Border Background="{DynamicResource CardInputBg}" BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="🔍" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Possible Causes" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="DetailCausesPanel" Orientation="Vertical"/>
                                </StackPanel>
                            </Border>

                            <!-- Section: Step-by-Step Resolution -->
                            <Border Background="{DynamicResource CardInputBg}" BorderBrush="#8B4DFF" 
                                    BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="🛠️" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Step-by-Step Resolution" FontWeight="Bold" FontSize="14" Foreground="#8B4DFF"/>
                                    </StackPanel>
                                    <StackPanel x:Name="DetailSolutionsPanel" Orientation="Vertical"/>
                                </StackPanel>
                            </Border>

                            <!-- Section: What to Check -->
                            <Border Background="{DynamicResource CardInputBg}" BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="📋" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="What to Check" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="DetailCheckPanel" Orientation="Vertical"/>
                                </StackPanel>
                            </Border>

                            <!-- Section: When to Contact Support -->
                            <Border Background="{DynamicResource CardInputBg}" BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="✉️" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="When to Contact Technical Support" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DetailWhenContactText" Text="..." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Related Articles -->
                            <TextBlock Text="Related Guides:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="RelatedArticlesPanel" Margin="0,0,0,20"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Button Content="✉️ Contact Technical Support" Background="{DynamicResource NavHoverBg}" 
                        Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" BorderThickness="0" 
                        Cursor="Hand" HorizontalAlignment="Left" Click="ContactSupport_Click"/>
                <Button Content="Close" Width="90" Height="30" HorizontalAlignment="Right" 
                        Background="{DynamicResource NavHoverBg}" Foreground="{DynamicResource PrimaryTextBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
