<UserControl x:Class="EDM.Views.CustomTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="38"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <Border Background="{DynamicResource HeaderBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid Background="Transparent"
              MouseLeftButtonDown="Root_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <!-- Logo and App Title (left) -->
                <ColumnDefinition Width="250"/>
                <!-- Drag space (center) -->
                <ColumnDefinition Width="*"/>
                <!-- Window Controls (right) -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT: App Title ===== -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <!-- App Title -->
                <TextBlock Text="Exclusive Download Manager"
                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>

            <!-- ===== CENTER: Drag Region ===== -->
            <Border Grid.Column="1" Background="Transparent"
                    MouseLeftButtonDown="Root_MouseLeftButtonDown"/>

            <!-- ===== RIGHT: Window Control Buttons ===== -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Minimize -->
                <Button x:Name="MinimizeButton" Width="46" Height="38"
                        Click="MinimizeButton_Click"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="Minimize">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" Width="46" Height="38">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE921;" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Maximize/Restore -->
                <Button x:Name="MaximizeButton" Width="46" Height="38"
                        Click="MaximizeButton_Click"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="Maximize">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" Width="46" Height="38">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE922;" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Close -->
                <Button x:Name="CloseButton" Width="46" Height="38"
                        Click="CloseButton_Click"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="Close">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" Width="46" Height="38">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EF4444"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#DC2626"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
