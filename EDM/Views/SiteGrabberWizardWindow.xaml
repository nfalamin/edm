<Window x:Class="EDM.Views.SiteGrabberWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EDM Site Grabber &amp; Web Crawler Wizard"
        Height="540" Width="740"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Stepper Indicator Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="Step1Label" Text="1. Target URL &amp; Rules" FontWeight="Bold" Foreground="{DynamicResource AccentColorBrush}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="Step2Label" Text="2. Resource Discovery" FontWeight="Normal" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" x:Name="Step3Label" Text="3. Filter &amp; Criteria" FontWeight="Normal" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3" x:Name="Step4Label" Text="4. Ingest &amp; Queue" FontWeight="Normal" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Wizard Page Content Area -->
        <Grid Grid.Row="1">
            <!-- STEP 1: Target URL & Scope -->
            <Grid x:Name="PageStep1" Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="Start Page URL:" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="StartUrlBox" Text="https://example.com/gallery" Padding="6" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,12" />

                    <TextBlock Text="Crawl Depth (Levels):" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="CrawlDepthCombo" SelectedIndex="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <ComboBoxItem Content="1 - Current Page Only" />
                        <ComboBoxItem Content="2 - Current Page + 1 Level" />
                        <ComboBoxItem Content="3 - Explore Deep (3 Levels)" />
                    </ComboBox>

                    <CheckBox x:Name="StayOnDomainCheck" Content="Stay within same domain (Strict SSRF protection active)" IsChecked="True" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />
                    <CheckBox x:Name="ExploreImagesCheck" Content="Download images (.jpg, .png, .webp)" IsChecked="True" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />
                    <CheckBox x:Name="ExploreDocsCheck" Content="Download documents (.pdf, .docx, .zip)" IsChecked="True" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />
                </StackPanel>
            </Grid>

            <!-- STEP 2: Discovered Resources Tree -->
            <Grid x:Name="PageStep2" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Discovered Assets on Target Page:" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />
                    <ListBox Grid.Row="1" x:Name="DiscoveryList" Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                </Grid>
            </Grid>

            <!-- STEP 3: Filters & Criteria -->
            <Grid x:Name="PageStep3" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Filter by Extensions (comma separated):" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="FilterExtBox" Text=".pdf, .zip, .png, .jpg, .mp4" Padding="6" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,12" />

                    <TextBlock Text="Regex Filter Pattern (Optional):" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="FilterRegexBox" Text="" Padding="6" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,12" />
                </StackPanel>
            </Grid>

            <!-- STEP 4: Final Ingest & Queue -->
            <Grid x:Name="PageStep4" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="🎉 Ready to Ingest into Download Queue" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentColorBrush}" Margin="0,0,0,8" />
                    <TextBlock x:Name="SummaryText" Text="Discovered 14 matching downloadable assets." Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12" />

                    <TextBlock Text="Target Queue:" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="TargetQueueCombo" SelectedIndex="0" Width="220" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <ComboBoxItem Content="Default Queue" />
                        <ComboBoxItem Content="Site Grabber Batch" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Navigation Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="PrevBtn" Content="‹ Previous" Click="OnPrevStep" IsEnabled="False" Padding="14,6" Margin="0,0,8,0" />
            <Button x:Name="NextBtn" Content="Next ›" Click="OnNextStep" Padding="16,6" Background="{DynamicResource AccentColorBrush}" Foreground="White" FontWeight="Bold" />
        </StackPanel>
    </Grid>
</Window>
