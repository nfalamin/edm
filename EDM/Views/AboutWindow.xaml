<Window x:Class="EDM.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Exclusive Download Manager" Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Tabs Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- HEADER BANNER -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- EDM Logo & Identity -->
                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#8B4DFF" Offset="0"/>
                            <GradientStop Color="#2E86FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#8B4DFF" BlurRadius="16" ShadowDepth="2" Opacity="0.6"/>
                    </Border.Effect>
                    <TextBlock Text="⚡" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Exclusive Download Manager" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Border Background="#8B4DFF" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionBadgeText" Text="v1.0.0" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="High-Performance Multi-Part Download Engine &amp; Media Management System" 
                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Channel Badge -->
                <Border Grid.Column="2" Background="{DynamicResource NavHoverBg}" BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock x:Name="ChannelBadgeText" Text="Stable Channel" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN TABS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="16,12,16,12">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" 
                                        BorderThickness="0,0,0,2" Padding="16,8" Margin="0,0,8,0" Cursor="Hand">
                                    <ContentPresenter ContentSource="Header" TextBlock.FontSize="13" TextBlock.FontWeight="SemiBold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#8B4DFF"/>
                                        <Setter Property="Foreground" Value="#8B4DFF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: OVERVIEW -->
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel Orientation="Vertical">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Info Card -->
                            <Border Grid.Column="0" Background="{DynamicResource CardInputBg}" BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Application Identity" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Product: Exclusive Download Manager (EDM)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                                    <TextBlock x:Name="CurrentVersionLabel" Text="Version: 6.0.0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                                    <TextBlock x:Name="BuildNumberLabel" Text="Build: 20260816.1" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                                    <TextBlock x:Name="ArchitectureLabel" Text="Architecture: X64 (Windows Desktop / WPF)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                                    <TextBlock x:Name="FrameworkLabel" Text="Runtime: .NET 10.0 Windows" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                                </StackPanel>
                            </Border>

                            <!-- Right License Card -->
                            <Border Grid.Column="1" Background="{DynamicResource CardInputBg}" BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1" CornerRadius="10" Padding="14" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="License &amp; Hardware Status" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Status: Licensed (Pro Tier)" FontSize="12" Foreground="#10B981" FontWeight="SemiBold" Margin="0,2"/>
                                    <TextBlock x:Name="MachineNameLabel" Text="Device: DESKTOP-USER" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                                    <TextBlock Text="Security: Windows DPAPI Vault Active" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                                    <TextBlock Text="Database: SQLite Write-Ahead Logging" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Key Highlights -->
                        <Border Background="{DynamicResource CardInputBg}" BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Core Architectural Capabilities" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="• Zero-Allocation ArrayPool&lt;byte&gt; streaming buffer management." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3"/>
                                <TextBlock Text="• Intelligent Adaptive Connection Scaling (1-32 parallel HTTP range streams)." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3"/>
                                <TextBlock Text="• Real-time 7-Language Dynamic Localization with Bi-directional RTL layout support." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3"/>
                                <TextBlock Text="• Native Browser Extension companions for Chrome, Edge, and Firefox." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3"/>
                                <TextBlock Text="• High-Reliability SQLite History Database with automated deduplication." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: WHAT'S NEW -->
            <TabItem Header="What's New">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel x:Name="WhatsNewPanel" Orientation="Vertical">
                        <!-- Populated in code-behind -->
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: VERSION HISTORY -->
            <TabItem Header="Version History">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel x:Name="VersionHistoryPanel" Orientation="Vertical">
                        <!-- Populated in code-behind with full changelog items -->
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: SYSTEM INFORMATION -->
            <TabItem Header="System Information">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel Orientation="Vertical">
                        <Border Background="{DynamicResource CardInputBg}" BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Host Environment Diagnostics" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Operating System:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,3"/>
                                    <TextBlock x:Name="SysOsText" Grid.Row="0" Grid.Column="1" Text="Windows 11 / 10" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,3"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text=".NET Runtime:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,3"/>
                                    <TextBlock x:Name="SysRuntimeText" Grid.Row="1" Grid.Column="1" Text=".NET 10.0" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,3"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Process Memory (Working Set):" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,3"/>
                                    <TextBlock x:Name="SysMemoryText" Grid.Row="2" Grid.Column="1" Text="45.2 MB" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,3"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Logical Processor Cores:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,3"/>
                                    <TextBlock x:Name="SysCoresText" Grid.Row="3" Grid.Column="1" Text="16 Cores" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,3"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Installation Directory:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,3"/>
                                    <TextBlock x:Name="SysPathText" Grid.Row="4" Grid.Column="1" Text="C:\Program Files\EDM\" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Database File:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,3"/>
                                    <TextBlock x:Name="SysDbText" Grid.Row="5" Grid.Column="1" Text="%LOCALAPPDATA%\EDM\edm_history.db" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="📋 Copy Diagnostics to Clipboard" Padding="12,6" Background="{DynamicResource NavHoverBg}" 
                                    Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1" Cursor="Hand" Click="CopyDiagnostics_Click" Margin="0,0,10,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: CHECK FOR UPDATES -->
            <TabItem Header="Check for Updates">
                <Grid Margin="0,12,0,0">
                    <Border Background="{DynamicResource CardInputBg}" BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" CornerRadius="10" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="EDM Software Update Channel" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="UpdateStatusText" Text="You are running Exclusive Download Manager v1.0.0 (Latest Release)." 
                                       FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,16"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="CheckUpdateBtn" Content="🔍 Check for Updates Now" Padding="16,8" 
                                        Background="#8B4DFF" Foreground="White" FontWeight="SemiBold" 
                                        BorderThickness="0" Cursor="Hand" Click="CheckUpdates_Click"/>
                            </StackPanel>

                            <ProgressBar x:Name="UpdateProgressBar" IsIndeterminate="True" Height="4" Width="240" 
                                         Visibility="Collapsed" Margin="0,16,0,0" Foreground="#8B4DFF"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock x:Name="CopyrightText" Text="Copyright © 2026 Exclusive Download Manager (EDM). All rights reserved." 
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                <Button Content="Close" Width="90" Height="30" HorizontalAlignment="Right" 
                        Background="{DynamicResource NavHoverBg}" Foreground="{DynamicResource PrimaryTextBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
