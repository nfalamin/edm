<Window x:Class="EDM.Views.RemoteZipPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote ZIP Central Directory Preview — EDM"
        Height="480" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   x:Name="ArchiveUrlText"
                   Text="📦 Remote Archive Inspection (HTTP Range Mode - Zero Full Download)"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Margin="0,0,0,12" />

        <!-- Tree / File Grid -->
        <DataGrid Grid.Row="1"
                  x:Name="EntriesGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Background="{DynamicResource SecondaryBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  Foreground="{DynamicResource PrimaryTextBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File / Path" Binding="{Binding FullPath}" Width="*" />
                <DataGridTextColumn Header="Uncompressed Size" Binding="{Binding FormattedUncompSize}" Width="140" />
                <DataGridTextColumn Header="Compressed Size" Binding="{Binding FormattedCompSize}" Width="130" />
                <DataGridTextColumn Header="Ratio" Binding="{Binding FormattedRatio}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Summary -->
        <TextBlock Grid.Row="2"
                   x:Name="SummaryText"
                   Text="Total: 0 files | Total Uncompressed: 0 MB"
                   FontSize="11"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,8,0,12" />

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close Preview" Click="OnClose" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="⬇ Download Full Archive" Click="OnDownloadFull" Padding="16,6" Background="{DynamicResource AccentColorBrush}" Foreground="White" FontWeight="Bold" />
        </StackPanel>
    </Grid>
</Window>
