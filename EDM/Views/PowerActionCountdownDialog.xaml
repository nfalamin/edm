<Window x:Class="EDM.Views.PowerActionCountdownDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EDM System Power Action Scheduler"
        Height="280" Width="480"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   x:Name="ActionTitleText"
                   Text="⚡ System Shutdown in Progress"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#FF7043" />

        <!-- Countdown & Description -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock x:Name="DescriptionText"
                       Text="All downloads in the queue have completed. The system will perform the scheduled power action automatically."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,12" />

            <TextBlock x:Name="CountdownText"
                       Text="30 seconds remaining..."
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AccentColorBrush}"
                       Margin="0,0,0,8" />

            <ProgressBar x:Name="CountdownProgress"
                         Height="8"
                         Minimum="0"
                         Maximum="30"
                         Value="30"
                         Foreground="{DynamicResource AccentColorBrush}"
                         Background="{DynamicResource SecondaryBackgroundBrush}" />
        </StackPanel>

        <!-- Warning -->
        <TextBlock Grid.Row="2"
                   Text="Click 'Cancel Action' at any time to abort and keep your computer running."
                   FontSize="11"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,8,0,14" />

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Execute Now"
                    Click="OnExecuteImmediately"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    Foreground="{DynamicResource PrimaryTextBrush}" />
            <Button Content="🚫 Cancel Power Action"
                    Click="OnCancelAction"
                    Padding="16,6"
                    Background="#E53935"
                    Foreground="White"
                    FontWeight="Bold" />
        </StackPanel>
    </Grid>
</Window>
