<UserControl x:Class="EDM.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EDM.Views"
             xmlns:converters="clr-namespace:EDM.Converters"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:BytesToGBConverter x:Key="BytesToGBConverter"/>
        <converters:SpeedFormatter x:Key="SpeedFormatter"/>
        <converters:CountFormatter x:Key="CountFormatter"/>
    </UserControl.Resources>

    <!-- Main 4-row layout -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== TOP HEADER BAR ==================== -->
        <Border x:Name="TopHeaderBar" Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Bar — Full width, larger and prominent -->
                <Border x:Name="SearchBoxBorder" Grid.Column="0" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,0" Height="40"
                        HorizontalAlignment="Stretch" Margin="0,0,16,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#7C3AED"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" x:Name="SearchTextBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryTextBrush}" Padding="0" VerticalAlignment="Center"
                                 FontSize="13" Text="" CaretBrush="{DynamicResource PrimaryTextBrush}"
                                 TextChanged="SearchTextBox_TextChanged"/>
                        <TextBlock Grid.Column="1" x:Name="SearchWatermark" Text="Search downloads..."
                                   Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" IsHitTestVisible="False"
                                   FontSize="13" Margin="2,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Right Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="12,0,0,0">

                    <!-- AI Assistant Button (🤖) -->
                    <Button x:Name="TopAiBtn" Click="TopAiBtn_Click"
                            Width="36" Height="36" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="EDM AI Assistant (Offline Chat &amp; Diagnostics)" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="AiBrd" Background="{DynamicResource CardInputBg}" 
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                        Width="36" Height="36" CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#8B4DFF" BlurRadius="8" ShadowDepth="1" Opacity="0.4"/>
                                    </Border.Effect>
                                    <TextBlock Text="🤖" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="AiBrd" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                        <Setter TargetName="AiBrd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Language Selector Button (🌐) with Flyout -->
                    <Grid Margin="0,0,6,0">
                        <Button x:Name="LanguageBtn" Click="LanguageBtn_Click"
                                Width="36" Height="36" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" ToolTip="Language">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="LangBrd" Background="{DynamicResource CardInputBg}" 
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                            Width="36" Height="36" CornerRadius="10">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                                        </Border.Effect>
                                        <TextBlock Text="🌐" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="LangBrd" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                            <Setter TargetName="LangBrd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Language Selection Popup -->
                        <Popup x:Name="LanguagePopup" StaysOpen="False" AllowsTransparency="True"
                               PlacementTarget="{Binding ElementName=LanguageBtn}" Placement="Bottom"
                               HorizontalOffset="-180" VerticalOffset="8">
                            <Border Width="240" Background="{DynamicResource SecondaryBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="10">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.35"/>
                                </Border.Effect>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Select Language" FontWeight="Bold" FontSize="12" 
                                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="8,4,8,8"/>

                                    <Button Tag="en-US" Click="SelectLanguage_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,1" Padding="8,6" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🇺🇸" FontSize="14" Margin="0,0,10,0"/>
                                            <TextBlock Text="English (US)" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Tag="bn-BD" Click="SelectLanguage_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,1" Padding="8,6" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🇧🇩" FontSize="14" Margin="0,0,10,0"/>
                                            <TextBlock Text="বাংলা (Bengali)" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Tag="hi-IN" Click="SelectLanguage_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,1" Padding="8,6" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🇮🇳" FontSize="14" Margin="0,0,10,0"/>
                                            <TextBlock Text="हिन्दी (Hindi)" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Tag="te-IN" Click="SelectLanguage_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,1" Padding="8,6" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🇮🇳" FontSize="14" Margin="0,0,10,0"/>
                                            <TextBlock Text="తెలుగు (Telugu)" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Tag="es-ES" Click="SelectLanguage_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,1" Padding="8,6" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🇪🇸" FontSize="14" Margin="0,0,10,0"/>
                                            <TextBlock Text="Español (Spanish)" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Tag="ar-SA" Click="SelectLanguage_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,1" Padding="8,6" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🇸🇦" FontSize="14" Margin="0,0,10,0"/>
                                            <TextBlock Text="العربية (Arabic) [RTL]" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Tag="ur-PK" Click="SelectLanguage_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,1" Padding="8,6" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🇵🇰" FontSize="14" Margin="0,0,10,0"/>
                                            <TextBlock Text="اردو (Urdu) [RTL]" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Help / Support Button (❓) -->
                    <Button x:Name="TopSupportBtn" Click="TopSupportBtn_Click"
                            Width="36" Height="36" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="Support &amp; Help Center" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SupportBrd" Background="{DynamicResource CardInputBg}" 
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                        Width="36" Height="36" CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                                    </Border.Effect>
                                    <TextBlock Text="❓" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SupportBrd" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                        <Setter TargetName="SupportBrd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- About EDM Button (ℹ️) -->
                    <Button x:Name="TopAboutBtn" Click="TopAboutBtn_Click"
                            Width="36" Height="36" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="About EDM &amp; Version History" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="AboutBrd" Background="{DynamicResource CardInputBg}" 
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                        Width="36" Height="36" CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                                    </Border.Effect>
                                    <TextBlock Text="ℹ️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="AboutBrd" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                        <Setter TargetName="AboutBrd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Settings Button (Gear) -->
                    <Button x:Name="TopSettingsBtn" Click="TopSettingsBtn_Click"
                            Width="36" Height="36" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="Settings" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SettingsBrd" Background="{DynamicResource CardInputBg}" 
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                        Width="36" Height="36" CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                                    </Border.Effect>
                                    <TextBlock Text="⚙️" FontSize="15" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SettingsBrd" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                        <Setter TargetName="SettingsBrd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Theme Toggle Button (Light/Dark Switch) -->
                    <Button x:Name="ThemeToggleBtn" Click="ThemeToggle_Click"
                            Width="36" Height="36" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="Toggle Theme" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ThemeBrd" Background="{DynamicResource CardInputBg}" 
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                        Width="36" Height="36" CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ThemeBrd" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                        <Setter TargetName="ThemeBrd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="ThemeIconText" Text="🌙" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Notification Bell with Flyout Popup -->
                    <Grid Margin="0,0,10,0">
                        <Button x:Name="NotificationBtn" Click="Notification_Click"
                                Width="36" Height="36" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" ToolTip="Notifications">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="NotifBrd" Background="{DynamicResource CardInputBg}" 
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                            Width="36" Height="36" CornerRadius="10">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                                        </Border.Effect>
                                        <TextBlock Text="🔔" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NotifBrd" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                            <Setter TargetName="NotifBrd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Notification Badge Overlay -->
                        <Grid x:Name="NotificationBadgeGrid" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" IsHitTestVisible="False">
                            <Ellipse Width="14" Height="14" Fill="#EF4444"/>
                            <TextBlock x:Name="NotificationCountText" Text="0" FontSize="8" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Notification Flyout Popup -->
                        <Popup x:Name="NotificationPopup" StaysOpen="False" AllowsTransparency="True"
                               PlacementTarget="{Binding ElementName=NotificationBtn}" Placement="Bottom"
                               HorizontalOffset="-260" VerticalOffset="8">
                            <Border Width="320" MaxHeight="400" Background="{DynamicResource SecondaryBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="14">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.3"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Popup Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="Notifications" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Mark all read" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Click="MarkAllRead_Click" Margin="0,0,8,0"/>
                                            <Button Content="Clear" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ClearNotifications_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Notifications List -->
                                    <ScrollViewer Grid.Row="1" MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="NotificationListPanel" Orientation="Vertical">
                                            <TextBlock x:Name="EmptyNotificationText" Text="No notifications yet." Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="12" HorizontalAlignment="Center" Margin="0,20"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Profile Pill -->
                    <Border x:Name="ProfilePillBorder" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="8,5" Cursor="Hand" ToolTip="User Account &amp; License"
                            MouseLeftButtonUp="ProfilePill_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Avatar -->
                            <Grid Grid.Column="0" Width="28" Height="28" Margin="0,0,8,0">
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#7C3AED" Offset="0"/>
                                            <GradientStop Color="#3B82F6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock x:Name="UserAvatarInitials" Text="EDM" FontSize="10" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Name -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameTextBlock" Text="EDM Pro User" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Licensed" FontSize="9" Foreground="#10B981" FontWeight="SemiBold"/>
                            </StackPanel>
                            <!-- Arrow -->
                            <TextBlock Grid.Column="2" Text="▾" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="8,0,2,0"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== QUICK ACTION TOOLBAR ==================== -->
        <Border Grid.Row="1" Background="{DynamicResource HeaderBackgroundBrush}" Padding="20,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <UniformGrid Columns="8" HorizontalAlignment="Stretch">

                <!-- Add URL -->
                <Button Tag="AddUrl" Click="ActionButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CardBrd" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                                <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid Width="44" Height="44" Margin="0,0,0,7" HorizontalAlignment="Center">
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#6366F1" Offset="0"/>
                                                    <GradientStop Color="#8B5CF6" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#8B5CF6" BlurRadius="18" ShadowDepth="2" Opacity="0.75"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="🔗" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="Add URL" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Resume -->
                <Button Tag="Resume" Click="ActionButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                                <Setter Property="BorderBrush" Value="#10B981"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid Width="44" Height="44" Margin="0,0,0,7" HorizontalAlignment="Center">
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#10B981" Offset="0"/>
                                                    <GradientStop Color="#22C55E" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#10B981" BlurRadius="18" ShadowDepth="2" Opacity="0.75"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="▶" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="Resume" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Pause -->
                <Button Tag="Pause" Click="ActionButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                                <Setter Property="BorderBrush" Value="#F59E0B"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid Width="44" Height="44" Margin="0,0,0,7" HorizontalAlignment="Center">
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#F59E0B" Offset="0"/>
                                                    <GradientStop Color="#F97316" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#F59E0B" BlurRadius="18" ShadowDepth="2" Opacity="0.75"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="⏸" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="Pause" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Stop -->
                <Button Tag="Stop" Click="ActionButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                                <Setter Property="BorderBrush" Value="#EF4444"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid Width="44" Height="44" Margin="0,0,0,7" HorizontalAlignment="Center">
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#EF4444" Offset="0"/>
                                                    <GradientStop Color="#DC2626" Offset="1"/>
