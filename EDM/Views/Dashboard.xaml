                                </Ellipse>
                                <TextBlock Text="✓" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Total Size Card — Click to show All -->
                    <Border Grid.Column="6" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18,16"
                            Cursor="Hand" MouseLeftButtonUp="OverviewCard_Click" Tag="AllDownloads">
