                            <TextBlock Text="🚀" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Max Speed" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding MaxSpeedLimit, FallbackValue='Unlimited'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>

    </Grid>

</UserControl>
