<Window x:Class="EDM.Views.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EDM User Account &amp; Zero-Knowledge Cloud Vault" Height="620" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Profile Card -->
            <RowDefinition Height="*"/>    <!-- Tabbed Hub Content -->
            <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
        </Grid.RowDefinitions>

        <!-- TOP PROFILE CARD -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar -->
                <Grid Grid.Column="0" Width="52" Height="52" Margin="0,0,16,0">
                    <Ellipse>
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="#06B6D4" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="AvatarInitialsText" Text="NF" FontSize="18" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- User Details -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UserNameText" Text="User" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Border x:Name="TierBadge" Background="#10B981" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TierBadgeText" Text="PRO CLOUD" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="UserEmailText" Text="user@local.edm" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Quick Auth Action -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AuthActionBtn" Content="⚡ Quick Connect / Passkey" Padding="12,6" Background="#8B4DFF" 
                            Foreground="White" FontWeight="SemiBold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Click="AuthActionBtn_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABBED HUB CONTENT -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: CLOUD SYNC & SNAPSHOTS -->
            <TabItem Header="☁️ Cloud Vault &amp; Sync" FontSize="12.5" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel Orientation="Vertical">
                        <!-- Storage Quota Card -->
                        <Border Background="{DynamicResource CardInputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Zero-Knowledge Encrypted Vault Storage" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock x:Name="StorageQuotaText" Text="42 MB / 50 GB Used" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="StorageProgressBar" Value="1" Maximum="100" Height="6" Margin="0,8,0,4" Foreground="#8B4DFF"/>
                                <TextBlock Text="🔒 Client-side AES-256-GCM encrypted. Raw download histories and URLs are inaccessible to servers." 
                                           FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Actions Row -->
                        <Grid Margin="0,0,0,12">
                            <TextBlock x:Name="LastSyncLabel" Text="Last Sync: Just now" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🔄 Backup Now" Padding="12,6" Background="{DynamicResource NavHoverBg}" Foreground="{DynamicResource PrimaryTextBrush}" 
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" FontSize="11.5" Click="BackupNow_Click" Margin="0,0,8,0">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Backup Snapshots Timeline -->
                        <TextBlock Text="RECENT CLOUD SNAPSHOTS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource CardInputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                            <StackPanel x:Name="SnapshotsPanel" Orientation="Vertical">
                                <!-- Populated dynamically in code-behind -->
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: LINKED DEVICES & REMOTE PUSH -->
            <TabItem Header="📱 Linked Devices" FontSize="12.5" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="MULTI-DEVICE PAIRING &amp; REMOTE DISPATCH" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource CardInputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                            <TextBlock Text="Downloads pushed from your mobile browser companion or remote web dashboard will automatically queue and start on this PC." 
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </Border>

                        <StackPanel x:Name="LinkedDevicesPanel" Orientation="Vertical">
                            <!-- Populated dynamically -->
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: WEBHOOK NOTIFICATIONS -->
            <TabItem Header="🔔 Webhooks &amp; Alerts" FontSize="12.5" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel Orientation="Vertical">
                        <Border Background="{DynamicResource CardInputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox x:Name="EnableWebhookCheckBox" Content="Enable Discord / Telegram / Webhook Alerts on Completion" 
                                          FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Webhook Target URL:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Height="36" Padding="8,0" Margin="0,0,0,10">
                                    <TextBox x:Name="WebhookUrlTextBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}" 
                                             FontSize="12" VerticalAlignment="Center" Text="https://discord.com/api/webhooks/example"/>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🚀 Test Webhook" Padding="12,6" Background="{DynamicResource NavHoverBg}" Foreground="{DynamicResource PrimaryTextBrush}" 
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" FontSize="11.5" Click="TestWebhook_Click" Margin="0,0,8,0">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="💾 Save Webhook Config" Padding="12,6" Background="#8B4DFF" Foreground="White" 
                                            BorderThickness="0" Cursor="Hand" FontSize="11.5" Click="SaveWebhook_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: ACCOUNT DETAILS & HARDWARE ID -->
            <TabItem Header="🔑 Account &amp; Hardware ID" FontSize="12.5" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Border Background="{DynamicResource CardInputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel Orientation="Vertical">
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="License Tier" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="Exclusive Download Manager Pro" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Hardware ID (HWID)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="HwidText" Text="EDM-HWID-VERIFIED" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Registered Machine" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="MachineNameText" Text="DESKTOP-LOCAL" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="DPAPI Vault Encryption" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="Active (Windows DPAPI + AES-GCM)" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- BOTTOM BUTTONS -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Content="ℹ️ About EDM" Padding="8,4" Background="Transparent" Foreground="{DynamicResource AccentBrush}" 
                        BorderThickness="0" Cursor="Hand" Click="AboutBtn_Click" Margin="0,0,6,0"/>
                <Button Content="❓ Support &amp; Help" Padding="8,4" Background="Transparent" Foreground="{DynamicResource AccentBrush}" 
                        BorderThickness="0" Cursor="Hand" Click="SupportBtn_Click" Margin="0,0,6,0"/>
                <Button Content="🛡️ Privacy Policy" Padding="8,4" Background="Transparent" Foreground="{DynamicResource AccentBrush}" 
                        BorderThickness="0" Cursor="Hand" Click="PrivacyBtn_Click"/>
            </StackPanel>

            <Button Content="Close" Width="90" Height="34" Background="{DynamicResource AccentBrush}" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Click="CloseBtn_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
