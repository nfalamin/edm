<Window x:Class="EDM.Views.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EDM Download Scheduler" Height="220" Width="400"
        Background="{DynamicResource BackgroundBrush}" 
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ১. টাইটেল -->
        <TextBlock Grid.Row="0" Text="Set Auto Download Start Time" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentHoverBrush}" Margin="0,0,0,15"/>

        <!-- ২. সময় ইনপুট লেআউট -->
        <StackPanel Grid.Row="1" Orientation="Vertical">
            <CheckBox x:Name="EnableSchedulerCheckBox" Content="Enable Download Scheduler" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" Margin="0,0,0,15" Checked="EnableSchedulerCheckBox_Click" Unchecked="EnableSchedulerCheckBox_Click"/>

            <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                <TextBlock Text="Start at (24-Hour Format):" Foreground="{DynamicResource DisabledBrush}" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"/>
                <TextBox x:Name="HourTextBox" Width="50" Height="25" Text="02" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" TextAlignment="Center" VerticalContentAlignment="Center" FontSize="12"/>
                <TextBlock Text=":" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" FontSize="14" Margin="5,0,5,0"/>
                <TextBox x:Name="MinuteTextBox" Width="50" Height="25" Text="00" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" TextAlignment="Center" VerticalContentAlignment="Center" FontSize="12"/>
                <TextBlock Text="(HH:MM)" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" FontSize="11" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ৩. বাটন প্যানেল -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Save &amp; Active" 
                    Style="{DynamicResource PrimaryButton}" 
                    Padding="15,6,15,6" Margin="0,0,10,0" FontWeight="SemiBold"
                    Click="SaveButton_Click"/>

            <Button Content="Cancel" 
                    Style="{DynamicResource SecondaryButton}" 
                    Padding="15,6,15,6"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
