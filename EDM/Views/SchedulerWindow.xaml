<Window x:Class="EDM.Views.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EDM.Views"
        Title="EDM Download Scheduler &amp; Queue Manager" Height="640" Width="720"
        MinWidth="580" MinHeight="500"
        Background="{DynamicResource BackgroundBrush}" 
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False">
    <Grid>
        <views:SchedulerView x:Name="MainSchedulerView"/>
    </Grid>
</Window>
