<UserControl x:Class="EDM.Views.SystemStatusBar" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Height="50">
    <Border Background="#181F2A" 
            BorderBrush="#26303D" 
            BorderThickness="0,1,0,0"
            Padding="20,0">
        <Grid Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Connection Status Pill -->
            <Border Grid.Column="0" 
                    CornerRadius="20" 
                    Background="#1A2028" 
                    BorderBrush="#3A4454" 
                    BorderThickness="1"
                    Padding="12,6"
                    Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📶" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ConnectionStatus" 
                               Text="High Speed" 
                               FontSize="11" 
                               Foreground="#E0E6ED" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Download Speed -->
            <Border Grid.Column="1" 
                    CornerRadius="20" 
                    Background="#1A2028" 
                    BorderBrush="#3A4454" 
                    BorderThickness="1"
                    Padding="12,6"
                    Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⬇" FontSize="14" Foreground="#34D399" Margin="0,0,8,0"/>
                    <TextBlock x:Name="DownloadSpeed" 
                               Text="6.2 MB/s" 
                               FontSize="11" 
                               Foreground="#34D399" 
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Upload Speed -->
            <Border Grid.Column="2" 
                    CornerRadius="20" 
                    Background="#1A2028" 
                    BorderBrush="#3A4454" 
                    BorderThickness="1"
                    Padding="12,6"
                    Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="☁" FontSize="14" Foreground="#3B82F6" Margin="0,0,8,0"/>
                    <TextBlock x:Name="UploadSpeed" 
                               Text="128.4 KB/s" 
                               FontSize="11" 
                               Foreground="#3B82F6" 
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Active Downloads Count Badge -->
            <Border Grid.Column="3" 
                    CornerRadius="20" 
                    Background="#1A2028" 
                    BorderBrush="#3A4454" 
                    BorderThickness="1"
                    Padding="12,6"
                    Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="14" Foreground="#F59E0B" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ActiveCount" 
                               Text="6 active" 
                               FontSize="11" 
                               Foreground="#F59E0B" 
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Speed Limit Status -->
            <Border Grid.Column="4" 
                    CornerRadius="20" 
                    Background="#1A2028" 
                    BorderBrush="#3A4454" 
                    BorderThickness="1"
                    Padding="12,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚀" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock x:Name="SpeedLimitStatus" 
                               Text="Unlimited" 
                               FontSize="11" 
                               Foreground="#8B5CF6" 
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Right spacer for alignment -->
            <Border Grid.Column="5"/>
        </Grid>
    </Border>
</UserControl>
