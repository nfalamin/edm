<Window x:Class="EDM.Views.RefreshAddressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Refresh Download Address - EDM"
        Height="470" Width="640"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#0B1120" Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <SolidColorBrush x:Key="DlgBg" Color="#0B1120"/>
        <SolidColorBrush x:Key="DlgCardBg" Color="#131D31"/>
        <SolidColorBrush x:Key="DlgInputBg" Color="#080E1A"/>
        <SolidColorBrush x:Key="DlgBorder" Color="#223354"/>
        <SolidColorBrush x:Key="DlgBorderHover" Color="#6366F1"/>
        <SolidColorBrush x:Key="DlgTextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DlgTextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="DlgAccent" Color="#6366F1"/>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource DlgInputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource DlgTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DlgBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource DlgBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🔄 Refresh Download Address" FontSize="17" FontWeight="Bold" Foreground="#60A5FA"/>
            <TextBlock Text="The current download address expired or was denied (HTTP 401/403/410). Enter a fresh download address to resume without losing existing progress."
                       FontSize="11.5" Foreground="{StaticResource DlgTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Content Card -->
        <Border Grid.Row="1" Background="{StaticResource DlgCardBg}" BorderBrush="{StaticResource DlgBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel>
                <!-- File Info Row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="FILE NAME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource DlgTextSecondary}"/>
                        <TextBlock x:Name="FileNameTextBlock" Text="Filename.mp4" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="SAVED PROGRESS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource DlgTextSecondary}" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="ProgressTextBlock" Text="0 B / 0 B (0%)" FontSize="13" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Current / Expired URL -->
                <TextBlock Text="Expired / Original Address:" FontSize="11" Foreground="{StaticResource DlgTextSecondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="OldUrlTextBox" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Opacity="0.6" Height="32" Margin="0,0,0,12"/>

                <!-- New URL Input -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="New Download Address (URL):" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="🌐 Open in Browser" Click="OpenInBrowser_Click" Style="{StaticResource SecondaryBtn}" Height="26" Padding="8,0" FontSize="10.5" Margin="0,0,6,0"/>
                        <Button Content="📋 Paste" Click="PasteClipboard_Click" Style="{StaticResource SecondaryBtn}" Height="26" Padding="8,0" FontSize="10.5"/>
                    </StackPanel>
                </Grid>
                <TextBox x:Name="NewUrlTextBox" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,10" TextChanged="NewUrlTextBox_TextChanged"/>

                <!-- Status / Validation Message -->
                <TextBlock x:Name="ValidationStatusText" Text="" FontSize="11" Foreground="#F59E0B" TextWrapping="Wrap" Margin="0,0,0,6"/>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RefreshResumeBtn" Content="🔄 Refresh &amp; Resume Download" Click="RefreshResumeBtn_Click" Style="{StaticResource PrimaryBtn}" Margin="0,0,10,0"/>
            <Button Content="Cancel" Click="CancelBtn_Click" Style="{StaticResource SecondaryBtn}"/>
        </StackPanel>
    </Grid>
</Window>