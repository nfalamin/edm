<Window x:Class="EDM.Views.ContextMenuRegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Context Menu Registration"
        Height="280" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Windows Explorer Context Menu" 
                   FontSize="18" 
                   FontWeight="Bold"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   Margin="0,0,0,16"/>

        <!-- Message -->
        <TextBlock Grid.Row="1" 
                   TextWrapping="Wrap"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Margin="0,0,0,16">
            <Run Text="This will register 'Download with EDM' option in Windows Explorer's right-click context menu for files and URLs (HTTP/HTTPS)."/>
            <LineBreak/>
            <LineBreak/>
            <Run FontWeight="Bold" Foreground="Orange">
                Administrator privileges are required to make this change.
            </Run>
        </TextBlock>

        <!-- Info Box -->
        <Border Grid.Row="2" 
                Background="{DynamicResource CardBrush}"
                        CornerRadius="8"
                        Padding="12"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="What this enables:" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="• Right-click any file → 'Download with EDM'" 
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="16,0,0,4"/>
                <TextBlock Text="• Right-click HTTP/HTTPS links → 'Download with EDM'" 
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="16,0,0,4"/>
                <TextBlock Text="• Selected file path automatically opens in EDM" 
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="100"
                    Height="35"
                    Style="{StaticResource SecondaryBtn}"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>
            <Button x:Name="ConfirmButton"
                    Content="Enable"
                    Width="100"
                    Height="35"
                    Style="{StaticResource PrimaryBtn}"
                    Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
