<Window x:Class="EDM.Views.CategoryRulesEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Category &amp; Folder Routing Rules"
        Height="460" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Category &amp; File Extension Routing Rules"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Margin="0,0,0,12" />

        <DataGrid Grid.Row="1"
                  x:Name="CategoryGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Background="{DynamicResource SecondaryBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  Foreground="{DynamicResource PrimaryTextBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Category Name" Binding="{Binding Name}" Width="140" />
                <DataGridTextColumn Header="Sub-Folder" Binding="{Binding DefaultSubFolder}" Width="140" />
                <DataGridTextColumn Header="File Extensions" Binding="{Binding ExtensionsDisplay}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- New Category Creation -->
        <Border Grid.Row="2"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,12,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="NameBox" Margin="2" Padding="4" ToolTip="Name (e.g. ISO Images)" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                <TextBox Grid.Column="1" x:Name="FolderBox" Margin="2" Padding="4" ToolTip="Folder Name" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                <TextBox Grid.Column="2" x:Name="ExtsBox" Margin="2" Padding="4" ToolTip="Extensions (.iso, .img, .bin)" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                <Button Grid.Column="3" Content="Add Category" Click="OnAddCategory" Margin="4,2,2,2" Padding="12,4" Background="{DynamicResource AccentColorBrush}" Foreground="White" />
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save &amp; Close" Click="OnClose" Padding="16,6" Background="{DynamicResource AccentColorBrush}" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
