<UserControl x:Class="EDM.Views.SchedulerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F1523" Foreground="#E2E8F0">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="⏰ Queue &amp; Scheduler Control Center" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Configure automated download start/stop schedules, bandwidth limits, and post-completion actions." FontSize="13" Foreground="#94A3B8" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,0">
                <!-- Schedule Times Card -->
                <Border Background="#131B2E" BorderBrush="#222F48" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="📅 Automated Queue Schedule" FontSize="15" FontWeight="SemiBold" Foreground="#A855F7" Margin="0,0,0,12"/>
                        <CheckBox x:Name="EnableSchedulerCheckBox" Content="Enable Automated Schedule" IsChecked="True" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Start Queue At:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="StartTimeTextBox" Text="02:00:00" Height="34" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Stop Queue At:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="StopTimeTextBox" Text="06:00:00" Height="34" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Concurrency & Bandwidth Limits Card -->
                <Border Background="#131B2E" BorderBrush="#222F48" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="⚡ Queue Concurrency &amp; Bandwidth" FontSize="15" FontWeight="SemiBold" Foreground="#10B981" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max Parallel Downloads:" FontSize="13" Foreground="#E2E8F0"/>
                            <TextBlock x:Name="ConcurrencyValueText" Grid.Column="1" Text="4 Downloads" FontSize="13" FontWeight="Bold" Foreground="#10B981"/>
                        </Grid>
                        <Slider x:Name="ConcurrencySlider" Minimum="1" Maximum="16" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ConcurrencySlider_ValueChanged" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Active Bandwidth Limit (Kbps, 0 = Unlimited):" VerticalAlignment="Center" FontSize="13" Foreground="#E2E8F0"/>
                            <TextBox x:Name="SpeedLimitTextBox" Grid.Column="1" Text="0" Height="34" FontSize="13" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Completion Actions Card -->
                <Border Background="#131B2E" BorderBrush="#222F48" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="⚙️ Post-Completion Automation" FontSize="15" FontWeight="SemiBold" Foreground="#3B82F6" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ShutdownPcCheckBox" Content="Shut down computer when queue finishes downloading" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ScanAvCheckBox" Content="Automatically scan files with Windows Defender after download" IsChecked="True" FontSize="13" Foreground="#FFFFFF"/>
                    </StackPanel>
                </Border>

                <!-- Save Action Button -->
                <Button x:Name="SaveSettingsButton" Content="Apply and Save Scheduler Settings" Click="SaveSettingsButton_Click" 
                        Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" Height="40" FontSize="14" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
