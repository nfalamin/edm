<Window x:Class="EDM.Views.PendingApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pending Download Approvals"
        Height="540" Width="680"
        MinHeight="400" MinWidth="550"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        Foreground="#F8FAFC">

    <Window.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="DlgBg" Color="#0B1120"/>
            <SolidColorBrush x:Key="DlgCardBg" Color="#131D31"/>
            <SolidColorBrush x:Key="DlgCardBorder" Color="#223354"/>
            <SolidColorBrush x:Key="DlgHeaderBg" Color="#0D1527"/>
            <SolidColorBrush x:Key="DlgTextPrimary" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DlgTextSecondary" Color="#94A3B8"/>
            <SolidColorBrush x:Key="DlgTextMuted" Color="#64748B"/>
            <SolidColorBrush x:Key="DlgAccent" Color="#6366F1"/>
            <SolidColorBrush x:Key="DlgSuccess" Color="#10B981"/>
            <SolidColorBrush x:Key="DlgDanger" Color="#EF4444"/>

            <Style x:Key="ApproveButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#6366F1"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#4F46E5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RejectButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1E293B"/>
                <Setter Property="Foreground" Value="#EF4444"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#334155"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2D1B2D"/>
                        <Setter Property="BorderBrush" Value="#EF4444"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource DlgHeaderBg}" CornerRadius="10" Padding="14,10" Margin="0,0,0,12" BorderBrush="{StaticResource DlgCardBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitleText" Text="🛡️ External Download Confirmation Gate" FontSize="15" FontWeight="Bold" Foreground="{StaticResource DlgTextPrimary}"/>
                    <TextBlock x:Name="HeaderSubtitleText" Text="Review external download requests before allowing network traffic." FontSize="12" Foreground="{StaticResource DlgTextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1E1B4B" CornerRadius="12" Padding="10,4" VerticalAlignment="Center" BorderBrush="#4338CA" BorderThickness="1">
                    <TextBlock x:Name="PendingCountBadge" Text="0 Pending" FontSize="12" FontWeight="Bold" Foreground="#818CF8"/>
                </Border>
            </Grid>
        </Border>

        <!-- Requests List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PendingItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource DlgCardBg}" BorderBrush="{StaticResource DlgCardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <DockPanel LastChildFill="True">
                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" DockPanel.Dock="Left">
                                            <TextBlock Text="{Binding SourceBadge}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource DlgTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>

                                    <TextBlock Text="{Binding Url}" FontSize="11" Foreground="{StaticResource DlgTextMuted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,4" ToolTip="{Binding Url}"/>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FormattedSize}" FontSize="11" Foreground="{StaticResource DlgTextSecondary}" Margin="0,0,12,0"/>
                                        <TextBlock Text="Created: " FontSize="11" Foreground="{StaticResource DlgTextMuted}"/>
                                        <TextBlock Text="{Binding CreatedAtUtc, StringFormat='{}{0:HH:mm:ss}'}" FontSize="11" Foreground="{StaticResource DlgTextSecondary}" Margin="0,0,12,0"/>
                                        <TextBlock Text="Expires in: 10m" FontSize="11" Foreground="#F59E0B"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="✓ Start Download" Style="{StaticResource ApproveButtonStyle}" Margin="0,0,6,0" Tag="{Binding PendingRequestId}" Click="ApproveItem_Click"/>
                                    <Button Content="✕ Reject" Style="{StaticResource RejectButtonStyle}" Tag="{Binding PendingRequestId}" Click="RejectItem_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty State -->
        <Border x:Name="EmptyStateCard" Grid.Row="1" Background="{StaticResource DlgCardBg}" BorderBrush="{StaticResource DlgCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="✅ All clear! No pending download requests." FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DlgTextSecondary}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="{StaticResource DlgHeaderBg}" CornerRadius="10" Padding="12,10" Margin="0,10,0,0" BorderBrush="{StaticResource DlgCardBorder}" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="StatusMessageText" Text="Select an action to proceed." FontSize="12" Foreground="{StaticResource DlgTextSecondary}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Approve All" Style="{StaticResource ApproveButtonStyle}" Margin="0,0,8,0" Click="ApproveAll_Click"/>
                    <Button Content="Reject All" Style="{StaticResource RejectButtonStyle}" Margin="0,0,8,0" Click="RejectAll_Click"/>
                    <Button Content="Close" Background="#334155" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" Padding="12,6" BorderThickness="0" Cursor="Hand" Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
