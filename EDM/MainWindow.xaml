<Window x:Class="EDM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:EDM.Views"
        mc:Ignorable="d"
        Title="Exclusive Download Manager" 
        Height="800" Width="1400"
        MinHeight="600" MinWidth="1100"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, Roboto, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closed"
        Icon="pack://application:,,,/EDM;component/Models/edm logo.ico">

    <!-- Outer Window Border with Rounded Glassmorphic Corners & Subtle Neon Rim -->
    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar Row -->
                <RowDefinition Height="38"/>
                <!-- Main Content Row -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== CUSTOM TITLE BAR (Top, spans full width) ===== -->
            <views:CustomTitleBar Grid.Row="0" Panel.ZIndex="100"/>

            <!-- ===== MAIN CONTENT AREA (Sidebar + Dashboard side-by-side) ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Left Sidebar: 250px fixed -->
                    <ColumnDefinition Width="250"/>
                    <!-- Main Dashboard: fills remaining width -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar Navigation -->
                <views:Sidebar x:Name="MainSidebar" Grid.Column="0"/>

                <!-- Main Dashboard Content -->
                <views:Dashboard x:Name="MainDashboard" Grid.Column="1"/>
            </Grid>
        </Grid>
    </Border>
</Window>
