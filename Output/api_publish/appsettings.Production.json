{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSql": "",
    "Sqlite": "Data Source=controlplane.db"
  },
  "Jwt": {
    "Issuer": "EDM.ControlPlane.Api",
    "Audience": "EDM.ClientApp",
    "ExpiryHours": 24
  },
  "Cors": {
    "AllowedOrigins": [
      "https://edm.local",
      "https://control.edm.local",
      "https://nfalamin.com"
    ]
  },
  "Security": {
    "EnforceHttps": true,
    "RateLimitingEnabled": true
  }
}
