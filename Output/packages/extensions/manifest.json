{
  "manifest_version": 3,
  "name": "Exclusive Download Manager (EDM) Video & Media Downloader",
  "version": "1.0.0",
  "description": "Enterprise-grade media sniffer & stream capturer for YouTube and all web video players. Integrates directly with Exclusive Download Manager.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting",
    "webRequest",
    "cookies",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["stream-interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*"],
      "js": ["yt-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["stream-interceptor.js", "yt-bridge.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "EDM Video Downloader",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "settings/settings.html"
}
